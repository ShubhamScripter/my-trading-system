                "bans"
              ]
            },
            "description": "Bans a user globally (roomId: null) or scoped to a specific room."
          }
        },
        {
          "name": "Revoke Ban (Unban User)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"banId\": \"{{banId}}\"\n}"
            },
            "url": {
              "raw": "{{adminBaseUrl}}/social/chat/bans/unban",
              "host": [
                "{{adminBaseUrl}}"
              ],
              "path": [
                "social",
                "chat",
                "bans",
                "unban"
              ]
            },
            "description": "Immediately unbans the user."
          }
        }
      ]
