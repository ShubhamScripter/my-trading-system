# Copy to .env for local development.
#
# Secrets and infrastructure ONLY. Product configuration — OTP lifetimes, attempt
# caps, resend cooldowns, password policy — is NOT here: it lives in
# auth/auth.constants.ts today and moves to the database settings engine when that
# lands. A deploy should never be required to change a cooldown.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
WEB_APP_URL=http://localhost:3000

# Local native PostgreSQL 16 (no Docker, no PgBouncer) — both URLs point at the same
# instance for now. DATABASE_DIRECT_URL exists because `prisma migrate` needs advisory
# locks and session state that transaction pooling does not preserve, so it must be
# able to bypass a pooler once one is introduced.
DATABASE_URL=postgresql://orebit:orebit@localhost:5432/orebit_dev
DATABASE_DIRECT_URL=postgresql://orebit:orebit@localhost:5432/orebit_dev
PG_POOL_MAX=10

  # Compose Redis instances require a password and listen on 127.0.0.1 only. The
  # password below is the compose fallback — set REDIS_PASSWORD and change all to
# match anywhere that is not a local machine.
REDIS_PASSWORD=orebit-local-dev
REDIS_URL=redis://:orebit-local-dev@localhost:6379
CHAT_REDIS_URL=redis://:orebit-local-dev@localhost:6381

# The DURABLE instance (compose port 6380) — the mail queue lives here and nothing
# else does. Two instances rather than two databases on one, because persistence is
# per-instance: the cache above runs `appendonly no` with an LRU eviction policy, so
# it is CONFIGURED to discard data under pressure. Correct for a rate-limit counter,
# unacceptable for a queued one-time code.
#
# Leave it unset on a single-instance dev box and the queue falls back to the cache —
# the service boots and says so loudly at startup. Set it anywhere that matters.
REDIS_DURABLE_URL=redis://:orebit-local-dev@localhost:6380

# Argon2id secret parameter. Rotating this invalidates every stored password hash.
PASSWORD_PEPPER=change-me-to-a-random-32-plus-character-secret

# The ES256 (ECDSA P-256) signing key. One key signs both access and refresh
# tokens; what separates them is the `aud` claim, pinned on both sides — see
# auth/security/jwt.ts. A base64-encoded PKCS#8 PEM; only the private half is ever
# configured, and the public point is computed at boot because verification needs
# it. The curve must be P-256 — ES256 mandates it, and boot fails on anything else.
# Generate with:
#   node -e "console.log(Buffer.from(require('crypto').generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
JWT_PRIVATE_KEY=

# AES-256-GCM key wrapping TOTP secrets at rest, in identity.totp_factors. Exactly
# 32 bytes, base64 — boot fails on any other length, because a short value is not a
# weaker key, it is a crash on the first enrollment.
#
# ROTATING THIS ORPHANS EVERY ENROLLED AUTHENTICATOR. The stored ciphertext can no
# longer be opened, and `openSecret` throws rather than silently returning wrong
# bytes and rejecting every legitimate code. A rotation is a migration, not a config
# change. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_SECRET_KEY=

# The TOTP KEY RING, and which key new secrets are sealed under.
#
# `TOTP_SECRET_KEY` above serves envelope versions 1 and 2, and it cannot be rotated
# on its own without orphaning every enrolled authenticator. These two are what make
# rotation possible instead: versions 3 and up take their key from the ring, and
# `needsReseal` re-encrypts each factor onto the active key the next time its owner
# verifies a code.
#
# TO ROTATE:
#   1. Generate a key:  openssl rand -base64 32
#   2. Add it to the ring under the next version number.
#   3. Point TOTP_ACTIVE_KEY_VERSION at it and deploy. New enrollments use it
#      immediately; existing factors migrate as their owners sign in.
#   4. Once nothing reports the old version, drop that entry from the ring.
#
# Rolling the pointer BACK to a previous version is a supported way to back out a bad
# rotation — factors re-seal downward too. Never remove a key while rows still name it:
# `openSecret` refuses rather than guessing, which surfaces as an internal error.
#
# Both may be left unset. That is the pre-rotation state, and it keeps working.
# TOTP_KEYS={"3":"<base64 32 bytes>"}
# TOTP_ACTIVE_KEY_VERSION=3

# HMAC key for the rate-limit key registry — see `tag()` in redis/keys.ts.
#
# Rate-limit keys are derived from emails, identifiers and IP addresses. Under a plain
# hash, anyone who can read a Redis dump can confirm whether a given address is in it
# by hashing the address themselves: the input space is a dictionary, not a secret. An
# HMAC moves the derivation behind a value that is not in the dump.
#
# Required, with no default — a fallback to the unkeyed hash would leave the weak path
# reachable in exactly the environment that forgot to set this.
#
# Rotating it re-namespaces every rate-limit and quota key at once, so every counter
# restarts from zero. That is a deliberate one-time reset rather than damage, but it is
# a reason to rotate on purpose. Generate with: openssl rand -base64 32
RATE_LIMIT_KEY_SECRET=

# AES-256-GCM key sealing the refresh token inside a browser's session record — see
# `BffSessionService` in auth/security/bff.session.ts.
#
# The browser holds only an opaque handle; the backend keeps both tokens in Redis, and
# the refresh token is sealed there because it is a multi-day grant and a dump of the
# volume must not hand it over. The handle is the envelope's AAD, so a record copied to
# another handle cannot be opened.
#
# Required, with no default — a fallback would mean the environment that forgot to set
# this is the one storing refresh tokens in the clear.
#
# Rotating it signs everybody out and nothing else: every sealed refresh token becomes
# unopenable, and the record holds no other durable fact. Generate with:
# openssl rand -base64 32
BFF_SESSION_KEY=

# WebAuthn relying party. The registrable domain ONLY — no scheme, no port. A
# passkey is cryptographically bound to the RP ID it was registered under, so this
# is effectively permanent per environment: changing it invalidates every passkey
# already enrolled. The origin passkeys are checked against is derived from
# WEB_APP_URL, so there is nothing else to keep in sync.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Orebit

# console = OTPs are printed to the log instead of sent. Never use it outside dev.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@orebit.io

# Optional second relay, tried only when the primary will NOT take a message —
# a connection failure, timeout or auth error. A rejected *recipient* is not
# retried here: a 550 for a mailbox that does not exist will be a 550 twice.
#
# Worth configuring: email is now the single factor behind every account, because
# account recovery is email-OTP login. A primary outage is not "codes are slow",
# it is "nobody can sign in". Leave SMTP_BACKUP_HOST empty to disable.
SMTP_BACKUP_HOST=
SMTP_BACKUP_PORT=587
SMTP_BACKUP_USER=
SMTP_BACKUP_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── The other four providers ────────────────────────────────────────────────
#
# Adapters exist for all of them (auth/oauth/) and NONE has been verified against
# live credentials. Every value is optional: a provider whose credentials are absent
# is refused with `oauth_provider_unsupported`, a 400 naming it, so leaving this
# whole block empty changes nothing about how the service behaves today.
#
# Two of them cannot create accounts, permanently, and it is not a limitation to
# work around: X exposes no email address through OAuth 2.0 at any access tier, and
# a Telegram account is a phone number. Those identities can be ATTACHED to an
# existing account and can sign it in forever after, but a user whose first contact
# is "Continue with X" has to sign up with an email first. See
# `oauth_email_unavailable`.

# Apple. Four values, because there is no static client secret: Apple issues a `.p8`
# EC key and expects a short-lived ES256 assertion built from it.
#   APPLE_CLIENT_ID is the SERVICES id (e.g. io.orebit.web), NOT the app id. Using
#   the app id produces a bare `invalid_client` that says nothing about why.
#   APPLE_PRIVATE_KEY is the .p8 file base64-encoded, following JWT_PRIVATE_KEY —
#   a PEM's newlines do not survive a shell, a compose file and a secret store
#   reliably, and the failure mode is a key that parses as garbage at first sign-in.
#     base64 -w0 AuthKey_XXXXXXXXXX.p8
#   Note the redirect must accept a POST: requesting the name/email scope obliges
#   `response_mode=form_post`, so Apple POSTs a form body instead of redirecting
#   with a query string.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:3000/auth/apple/callback

# Facebook. The app secret also keys `appsecret_proof` on the Graph call, so an
# exfiltrated access token is not enough to read a profile.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# X. A confidential client — the secret travels in a Basic header, not the body.
# PKCE is mandatory here even for confidential clients.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# Telegram. One value, and no redirect URI: the callback URL is configured in the
# bot's domain settings at Telegram rather than here.
#
# This token IS the signing secret — SHA256(token) keys the HMAC that authenticates
# every Telegram login — so treat it with the weight of JWT_PRIVATE_KEY, not of an
# identifier. Anyone holding it can forge any Telegram identity.
TELEGRAM_BOT_TOKEN=

# Captcha. The four secrets are REQUIRED in production — the process refuses to
# boot without them — and captcha is mandatory on register and both login paths,
# so an unset secret means those flows cannot succeed at all.
# Leave them empty in development; the console transport does not call a provider.
# One SITE KEY and one SECRET per provider. The site key is public — it ships to the
# browser either way — and is served by GET /auth/captcha so the login and register
# pages do not carry their own copy of which providers are live.
#
# The SECRET is what makes a provider live. In production ALL FOUR secrets are
# required, and any provider whose secret is set must also have its site key set:
# a provider the browser cannot render is worse than one that is off.
#
# To take a provider out of rotation WITHOUT a redeploy, disable it in the database
# instead — the admin service owns the table and this service reads it:
#
#   INSERT INTO admin.admin_captcha_providers (provider, enabled, reason)
#   VALUES ('HCAPTCHA', false, 'vendor incident');
#
# That can only ever subtract from what is configured here. It can never add a
# provider, because a provider with no secret cannot be verified.
CAPTCHA_TURNSTILE_SITE_KEY=
CAPTCHA_TURNSTILE_SECRET=
CAPTCHA_RECAPTCHA_V2_SITE_KEY=
CAPTCHA_RECAPTCHA_V2_SECRET=
CAPTCHA_RECAPTCHA_V3_SITE_KEY=
CAPTCHA_RECAPTCHA_V3_SECRET=
CAPTCHA_HCAPTCHA_SITE_KEY=
CAPTCHA_HCAPTCHA_SECRET=

# The remaining three have working defaults and are never required. Hostnames are
# added to WEB_APP_URL's own host, which is always allowed.
# CAPTCHA_ALLOWED_HOSTNAMES=
# CAPTCHA_TIMEOUT_MS=5000
# CAPTCHA_RECAPTCHA_V3_MIN_SCORE=0.5

# Comma-separated CIDRs of the proxies actually in front of this service, e.g.
# Cloudflare's published ranges. Leave EMPTY when the service is exposed directly.
#
# This is not a boolean, and that matters: "trust any proxy" makes Fastify believe
# the leftmost X-Forwarded-For entry, which the client writes — so every rate limit
# keyed on the IP becomes one bucket per caller, i.e. no limit at all. Naming the
# proxies is what makes the resolved address one the client could not choose.
#
# Fastify reads X-Forwarded-For, NOT CF-Connecting-IP.
TRUSTED_PROXIES=

# Whether Cloudflare is the ingress, and its request headers may therefore be
# believed. Only `CF-IPCountry` is read, and only to establish the country the
# security-restriction evaluator compares against an account's session history.
#
# Default false. Leave it unset unless BOTH of these are true:
#
#   1. Cloudflare is actually in front of this process, and
#   2. TRUSTED_PROXIES above lists Cloudflare's published ranges
#      (https://cloudflare.com/ips), so req.ip is the real client rather than
#      Cloudflare's edge.
#
# Both are required, and the second is not implied by the first. TRUSTED_PROXIES
# says whose X-Forwarded-For decides req.ip — it says nothing about WHO that proxy
# is. Behind a plain nginx the list is legitimately non-empty, and a CF-IPCountry
# header written by the CLIENT passes straight through untouched and arrives looking
# exactly like Cloudflare's. A caller who can choose their own country can choose
# whether they look familiar, which inverts the whole classification.
#
# With this off, country is simply unknown — and unknown is never treated as "a new
# country", so the evaluator degrades to IP and device evidence rather than
# misclassifying anyone. Nothing breaks; the country term is just inert.
# TRUST_CLOUDFLARE_HEADERS=false

# Serve the browsable API reference at /docs, read from openapi.json at the repo
# root. Unset means on everywhere except production: a full description of an
# auth API is a map of its doors, so exposing it in production has to be a
# deliberate act rather than a default someone forgot to turn off.
DOCS_ENABLED=true
