// OREBiT — database schema
//
// Every model in the product lives in this file. DDL that Prisma cannot express —
// partial unique indexes, today — lives in db/sql/*.sql and is applied file by
// file, in lexicographic order, after every migration by db/migrate.ts.
//
// Conventions:
//   ids     uuid holding a UUIDv7 from src/utils/index.ts's uuidv7(). Time-ordered,
//           so inserts stay at the right edge of the B-tree. Never gen_random_uuid()
//           and never node:crypto's randomUUID(), which is v4 and scatters writes.
//   time    DateTime @db.Timestamptz, stored UTC.
//   delete  deletedAt DateTime? plus a partial index WHERE deleted_at IS NULL.
//   naming  snake_case columns via @map, plural table names via @@map.
//   casing  a user-supplied identifier is stored twice — `x` as typed for display,
//           `xLower`/`xKey` normalised, and the normalised one carries uniqueness.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // `prisma migrate` needs advisory locks and session state that transaction
  // pooling does not preserve, so it must be able to bypass a pooler. Both URLs
  // point at the same instance today; that changes when PgBouncer arrives, and
  // this is here so it changes in one place.
  directUrl = env("DATABASE_DIRECT_URL")

  // One schema per domain. Only `identity` exists so far; wallet, ledger and the
  // rest claim theirs as they are built.
  schemas = ["identity", "chat"]
}

// ─────────────────────────────────────────────────────────────────────────────
// identity — accounts, credentials, sessions, registration
// ─────────────────────────────────────────────────────────────────────────────

/// One row per registered account.
///
/// Uniqueness for `emailLower`, `usernameLower` and `publicCodeKey` is a PARTIAL
/// unique index in db/sql/identity.sql, not a column constraint here. That is
/// load-bearing, not incidental: a plain `@unique` would keep a soft-deleted
/// account's email and username reserved forever, so deleting an account would
/// permanently burn its email address and no user could ever move an address back.
model User {
  id            String @id @db.Uuid
  /// The identifier shown to the user and accepted at login — `OREBiT` + 8
  /// Crockford base32 characters. Stored rather than derived from `id` because
  /// login resolves it, so it has to be indexable.
  publicCode    String @map("public_code")
  /// Uppercased `publicCode`; carries the unique index and is what lookups match,
  /// so a user typing `orebit7q9k2m4x` still finds their account.
  publicCodeKey String @map("public_code_key")

  /// Auto-generated at account creation and never prompted for — see
  /// `generateUsernameCandidates` in auth/auth.utility.ts.
  username      String
  usernameLower String @map("username_lower")

  email      String
  emailLower String @map("email_lower")
  /// Set when a registration OTP is verified, or when a provider asserted the
  /// address was verified. Null means the address was never proven.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz

  /// When this account's ACTIVE address last moved, and the sole authority for the
  /// security cooldown that freezes 2FA, the Payment PIN and the password after a
  /// change. See `SECURITY_COOLDOWN` in auth/auth.constants.ts.
  ///
  /// Null means the address has never been changed — a freshly registered account, or
  /// one whose only change has since been undone by a recovery `restore`.
  ///
  /// ─── Why a column here and not a read of `retained_emails` ────────────────
  ///
  /// `RetainedEmail` answers a different question: which released address is still
  /// reserved, and until when. Deriving "changed recently" from it is wrong in three
  /// separate ways — a recovery `restore` DELETES the row, a `replace` renews
  /// `expiresAt` while leaving `createdAt` at the original change, and `changeEmail`
  /// deletes the caller's own rows when an address is reclaimed. Each of those would
  /// silently shorten or erase a security freeze.
  ///
  /// Written inside the same transaction as `email`/`emailLower` — in `changeEmail`
  /// and `recoverEmail` — so there is no instant at which the address has moved and
  /// this has not.
  emailChangedAt  DateTime? @map("email_changed_at") @db.Timestamptz

  status UserStatus @default(ACTIVE)

  /// The country the user picked on the last registration step. A self-declared
  /// preference — nothing gates on it, deliberately, because a value the user
  /// types is not evidence of anything.
  countryDeclared String? @map("country_declared") @db.Char(2)
  /// The country of the IP the account was last seen from. Null for every account
  /// today: `NullGeoResolver` is the shipped implementation, and the column is
  /// here now because it cannot be backfilled for signups that already happened.
  countryIp       String? @map("country_ip") @db.Char(2)

  /// The avatar image URL asserted by an OAuth provider (e.g. Google profile photo)
  /// or uploaded by the user.
  avatarUrl       String? @map("avatar_url")

  /// ─── the anti-phishing code ───────────────────────────────────────────────
  ///
  /// A short string the account's owner chooses, printed in the emails this service
  /// sends so a reader can tell a genuine one from a forgery. `ciphertext IS NULL` IS
  /// the setting — there is no separate flag to disagree with it, following
  /// `PaymentPin`.
  ///
  /// ─── Why ENCRYPTED, and not hashed like every other user-chosen secret ────
  ///
  /// Because the feature is to display it. `PaymentPin.pinHash` is argon2id and
  /// `RecoveryCode.codeHash` is sha256+pepper because nothing ever needs those values
  /// back — only a comparison. This one has to be read back on every outbound email,
  /// so a one-way hash makes it unusable. That is the identical argument
  /// `TotpFactor.secretCiphertext` makes, and this is the second and only other place
  /// in this schema where it applies.
  ///
  /// Not PLAINTEXT either, even though the value ends up in an inbox. A database
  /// reader holding these codes could forge mail that passes the exact check the
  /// feature teaches users to make, for every account at once — which defeats the
  /// feature rather than merely leaking a preference. So it gets the envelope.
  ///
  /// ─── Why columns on `users` rather than a table, unlike PaymentPin ────────
  ///
  /// This is the one place this feature deviates from the `PaymentPin` precedent, and
  /// the reason is the mail path. Every outbound email needs this value, and the
  /// notification callers already load this row to get the address — so on `users` it
  /// costs nothing, while a side table would add a query to every email the service
  /// sends, including fire-and-forget ones that must not grow a round trip.
  ///
  /// Four columns rather than one concatenated blob, so a rotation can rewrite them
  /// per row — `TotpFactor`'s reason, and `keyVersion` is what lets a retired key stay
  /// readable while rows drain onto the active one. The ring is shared with TOTP; see
  /// src/utils/sealed-secret.ts for what that obliges.
  ///
  /// AAD is `anti-phishing:v1:<userId>`, so these columns cannot be copied onto
  /// another account's row and opened.
  antiPhishingCiphertext Bytes? @map("anti_phishing_ciphertext")
  antiPhishingIv         Bytes? @map("anti_phishing_iv")
  antiPhishingTag        Bytes? @map("anti_phishing_tag")
  antiPhishingKeyVersion Int?   @map("anti_phishing_key_version")
  /// When the code was first set. Not bumped by a change — the security-changed email
  /// and the log line are the record of those, exactly as they are for the Payment PIN.
  antiPhishingSetAt      DateTime? @map("anti_phishing_set_at") @db.Timestamptz

  /// This account's own shareable code — the target `check-referral` matches
  /// against. Generated for every account at creation, which is what makes the
  /// check resolve at all.
  referralCode     String  @map("referral_code")
  /// The code this account signed up with, as entered. Kept as the raw string
  /// alongside the resolved id below so a code that was valid at signup stays
  /// on record even if the referrer is later deleted.
  referredByCode   String? @map("referred_by_code")
  referredByUserId String? @map("referred_by_user_id") @db.Uuid
  referredBy       User?   @relation("Referral", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals        User[]  @relation("Referral")

  registeredAt DateTime  @default(now()) @map("registered_at") @db.Timestamptz
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz

  /// ─── the soft-delete filter, and what it is NOT ───────────────────────────
  ///
  /// Pre-existing infrastructure: every lookup in `UserDbOperation` filters
  /// `deletedAt: null`, and the partial unique indexes above are scoped the same way,
  /// so a row carrying it is invisible to authentication and does not reserve its
  /// email or username.
  ///
  /// Account deletion does NOT use it to represent a deleted account. There are two
  /// states and this column is null in the only one that has a row:
  ///
  ///   DELETED (locked, recoverable) — status=DELETED, deletedAt NULL, purgeAt future.
  ///     The row still holds its email, username and public code, precisely because
  ///     `deletedAt` is null, and that reservation is what lets reactivation be
  ///     promised: nobody else can have taken the identifiers.
  ///
  ///   HARD DELETED — there is no row. `AccountPurgeSweeper` issues a real
  ///     `DELETE FROM users`, which cascades to every child table. The absence of the
  ///     row is the terminal state; there is no tombstone and no purged status to read.
  ///     Reactivation is impossible rather than refused, and the identifiers are free
  ///     because nothing holds them.
  ///
  /// `purgeAccount` does write this column, transiently: the conditional UPDATE that
  /// claims a due row sets it in the same transaction that deletes the row, so it takes
  /// the row lock and re-states the preconditions without ever reaching disk. It is a
  /// claim, not a state.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  /// ─── the delayed deletion ─────────────────────────────────────────────────
  ///
  /// Stamped together by `POST /settings/security/delete-account`, which also moves
  /// `status` to DELETED and revokes every session. Cleared together by a
  /// reactivation inside the window.
  ///
  /// Both, rather than deriving the deadline from the request time and the constant:
  /// `ACCOUNT_DELETION.RECOVERY_DAYS` is product policy and may change, and a user
  /// was promised a specific date. Storing it means changing the constant never moves
  /// a deadline already given. `OauthLink.unlinkRequestedAt`/`unlinkAt` make the same
  /// split for the same reason.
  ///
  /// `deletionRequestedAt` is an audit column — it records when the request landed and
  /// is never exposed by the API. `purgeAt` is the actionable one: it is what the
  /// reactivation compares against and the sweep's only query.
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz
  purgeAt             DateTime? @map("purge_at") @db.Timestamptz

  credentials    Credential[]
  sessions       Session[]
  oauthLinks     OauthLink[]
  challenges     VerificationChallenge[]
  trustedDevices TrustedDevice[]
  registrations Registration[]

  totpFactors    TotpFactor[]
  passkeys       Passkey[]
  recoveryCodes  RecoveryCode[]
  loginAttempts  LoginAttempt[]

  /// Singular, unlike every other relation above: one Payment PIN per account, and
  /// the optionality IS the setting. See `PaymentPin`.
  paymentPin     PaymentPin?

  /// Addresses this account has released by changing its email, still inside their
  /// retention window. Plural because the rows are kept after they expire; at most
  /// one is ever LIVE — see `RetainedEmail`.
  retainedEmails RetainedEmail[]

  /// Usernames this account has released by changing its username. Plural for
  /// `retainedEmails`' reason and one of its own: unlike addresses, SEVERAL may be
  /// live at once — one long reservation plus a short release still draining. See
  /// `UsernameReservation`.
  usernameReservations UsernameReservation[]

  /// Features and sub-features temporarily withheld from this account after a
  /// sensitive security action. Plural and freely overlapping — two triggers inside
  /// one window legitimately produce two live rows, and expired rows are kept. See
  /// `UserFeatureRestriction`.
  featureRestrictions UserFeatureRestriction[]

  @@index([status, registeredAt])
  @@index([referredByUserId])
  /// The purge sweep's only query: which deleted accounts are due. Partial would be
  /// better still, but Prisma cannot express one — see db/sql/identity.sql, which
  /// narrows this to the rows that can actually be due.
  @@index([purgeAt])
  @@map("users")
  @@schema("identity")
}

enum UserStatus {
  ACTIVE
  /// Reserved. There is no disable flow yet, but the state must exist now so
  /// `status` is never re-typed later.
  DISABLED
  /// The owner deleted the account and it is inside its thirty-day recovery window:
  /// locked, unable to authenticate, still restorable. It is the ONLY deleted state a
  /// row can be in — once the window expires the row is physically deleted, so there is
  /// no status value for "purged" and deliberately none is added. See `User.deletedAt`.
  ///
  /// Its OWN value rather than reusing DISABLED, and that is load-bearing: the two
  /// mean different things to a user and would mean different things to a support
  /// agent reading the column. DISABLED is something done TO an account; this is
  /// something its owner asked for and can undo for thirty days. Sharing one value
  /// would make "may this be reactivated" unanswerable from the row.
  ///
  /// Nothing extra is needed to keep a deleted account out: every path that checks
  /// `status !== 'ACTIVE'` already refuses this the day it is added.
  DELETED

  @@schema("identity")
}

/// One row per (user, kind) credential.
///
/// A user may legitimately have NO row here, and two ordinary paths produce that:
/// registration where the user skipped setting a password, and an account created
/// through a third-party provider. `login` treats a missing credential the same as
/// a wrong password everywhere except the one place the product asks it not to —
/// see the `otp_required` outcome in auth.service.ts.
model Credential {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind CredentialKind @default(PASSWORD)
  /// argon2id encoded string — carries its own salt and parameters, which is why
  /// there is no separate salt column.
  passwordHash String @map("password_hash")
  passwordAlgo String @default("argon2id") @map("password_algo")

  /// Durable lockout state. In the database rather than Redis on purpose: it must
  /// keep enforcing with the cache down, which is exactly when a brute-force
  /// attempt is most likely to be tried.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz

  /// How many times this credential has been locked — the rung it stands on.
  ///
  /// A flat penalty is a penalty an attacker can budget for: fifteen minutes means
  /// ninety-six lockout cycles a day against one account, forever, at no increasing
  /// cost. Counting the locks lets the second cost an hour and the third a day, while
  /// a real person who has forgotten their password still waits the same fifteen
  /// minutes they always did.
  ///
  /// Beside `failedAttempts` rather than in Redis for the same reason it is: a
  /// ladder a cache flush resets is a ladder that never climbs.
  lockoutStrikes   Int       @default(0) @map("lockout_strikes")
  /// When the most recent strike was earned. The ladder's memory decays from HERE,
  /// not from the first strike — anchoring to the first would let a patient caller
  /// wait out the window and start again at rung one indefinitely.
  lockoutStrikeAt  DateTime? @map("lockout_strike_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([userId, kind])
  @@map("credentials")
  @@schema("identity")
}

enum CredentialKind {
  PASSWORD
  /// PASSKEY and TOTP are intentionally absent, and stay that way now that 2FA has
  /// landed: they have their own tables below, because neither is a password hash
  /// with a different label. An enum member should exist only once something
  /// writes it, and nothing writes these.

  @@schema("identity")
}

// ─── the second factor ──────────────────────────────────────────────────────
//
// Ported from Orebit-admin-backend, with one difference that shapes all of it:
// here 2FA is OPT-IN. An account with no confirmed factor signs in exactly as it
// always did, in one call, and never learns any of this exists.
//
// Three tables rather than one, because the three things behave differently: a
// TOTP secret is a shared secret we must protect at rest, a passkey is a public
// key we need not protect at all, and a recovery code is a single-use string with
// no lifecycle beyond being spent. Folding them together would mean a table where
// most columns are null most of the time.

/// A confirmed authenticator app, or an abandoned enrollment.
model TotpFactor {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// AES-256-GCM envelope. Three columns rather than one concatenated blob so a
  /// rotation can rewrite them per row.
  ///
  /// Encrypted rather than hashed, which is the one place TOTP differs from every
  /// other secret in this schema: verifying a code requires REGENERATING it from
  /// the secret, so a one-way hash would make the factor unusable. The envelope is
  /// what keeps a database dump from being a set of working authenticators.
  secretCiphertext Bytes @map("secret_ciphertext")
  secretIv         Bytes @map("secret_iv")
  secretTag        Bytes @map("secret_tag")

  /// Which key sealed this row, and under which rules.
  ///
  /// Version 1 is the original envelope: one key from `TOTP_SECRET_KEY`, no
  /// additional authenticated data. Version 2 binds the envelope to (user_id, id)
  /// as GCM AAD, so a ciphertext moved to another factor's row — or another user's —
  /// fails its tag check instead of decrypting into a working authenticator.
  ///
  /// The column exists because the two cannot be told apart from the bytes. Without
  /// it, adding AAD would have made every already-enrolled authenticator
  /// undecryptable; with it, `openFactorSecret` picks the rules the row was written
  /// under and a v1 row is re-sealed as v2 the next time it verifies.
  ///
  /// It is also what makes key rotation possible at all: a versioned key map can
  /// hold the retired key for as long as rows still name it. Note the old comment
  /// here claimed rotation was "a plain UPDATE per row" while config.ts said it
  /// orphaned every authenticator — config.ts was right, and this is the column
  /// that makes the claim true.
  keyVersion Int @default(1) @map("key_version")

  /// What the user named this authenticator. Cosmetic.
  label String @default("Authenticator")

  /// Null until a code generated from this secret has been verified once.
  ///
  /// An UNCONFIRMED factor grants nothing: it does not satisfy a sign-in and it
  /// does not count toward "is enrolled". That is what makes an abandoned
  /// enrollment harmless — the QR code was scanned, the tab was closed, and the
  /// account is exactly where it was.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz

  /// The RFC 6238 time-step counter of the last code accepted.
  ///
  /// This is the replay defence, and it is a column rather than a cache entry
  /// because it must survive a Redis flush. Verification refuses any step `<=`
  /// this value, so a code shoulder-surfed or captured in transit cannot be spent
  /// a second time inside the ~90 seconds it remains arithmetically valid.
  ///
  /// Updated by a CONDITIONAL update (`WHERE last_used_step < :step`), never by
  /// read-then-write — two concurrent requests presenting the same code must not
  /// both observe the old value and both pass.
  lastUsedStep BigInt?   @map("last_used_step")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([userId, confirmedAt])
  @@map("totp_factors")
  @@schema("identity")
}

/// A registered passkey (WebAuthn credential).
///
/// No secret is stored here at all, which is the whole appeal of the mechanism:
/// `publicKey` is public, and the private half never leaves the authenticator. A
/// full dump of this table lets an attacker verify assertions, not forge them.
model Passkey {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The authenticator's own credential ID, base64url. Unique among live rows via
  /// a partial index in db/sql/identity.sql — partial so that removing a passkey
  /// (a soft delete) does not permanently bar the owner from registering that same
  /// authenticator again.
  credentialId String @map("credential_id")
  /// COSE-encoded public key, as returned by @simplewebauthn/server.
  publicKey    Bytes  @map("public_key")

  /// The authenticator's signature counter.
  ///
  /// Stored so a DECREASE can be detected, which is the documented signal of a
  /// cloned authenticator. It is logged rather than hard-failed: a large number of
  /// authenticators — most platform ones, and every passkey synced through a
  /// password manager — legitimately report a permanent 0, so refusing on a
  /// non-increase would lock out the most common hardware in use.
  signCount BigInt @default(0) @map("sign_count")

  /// How the browser said it can talk to this authenticator: usb, nfc, ble,
  /// internal, hybrid. Passed back in `allowCredentials` so the browser prompts for
  /// the right thing instead of offering every option.
  transports String[] @default([])
  /// The authenticator model's identifier. Provenance only — nothing gates on it.
  aaguid     String?

  label String @default("Passkey")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  @@index([userId])
  @@map("passkeys")
  @@schema("identity")
}

/// One printable single-use code from the set issued at enrollment.
///
/// ─── Why this table exists here and not in the admin service ────────────────
///
/// An admin enrols two kinds of factor and has an IT team behind them, so either
/// factor recovers the other. A consumer typically enrols one authenticator on one
/// phone. Losing it without these means losing the account outright — email OTP is
/// only the FIRST factor, so it cannot let anyone back past the second.
///
/// Hashed, never stored in the clear, and shown to the user exactly once. The
/// hash domain is `'recovery'` and not `'otp'`: domain separation is what stops a
/// value lifted from one column verifying against another.
model RecoveryCode {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String @map("code_hash")

  /// Terminal marker. Spent codes are retained rather than deleted, so "how many
  /// are left" and "was one used the night of the incident" both stay answerable.
  usedAt DateTime? @map("used_at") @db.Timestamptz

  /// When a newer generation replaced this row.
  ///
  /// The column that makes the promise above true. Regeneration used to
  /// `deleteMany({ where: { userId } })` — the only hard delete in any dboperation
  /// in this repo — and it was unscoped by `usedAt`, so it erased SPENT rows too and
  /// destroyed exactly the audit trail the comment above guarantees. Removing the
  /// last factor did the same, wiping the entire history.
  ///
  /// Superseded rows stay unusable because every lookup filters on it, and stay
  /// countable because "how many live codes remain" now means
  /// `usedAt IS NULL AND superseded_at IS NULL`.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, usedAt])
  @@map("recovery_codes")
  @@schema("identity")
}

/// The account's Payment PIN. At most one row per user, and its EXISTENCE is the
/// setting — there is no `enabled` column to disagree with it.
///
/// ─── Why this is not a second factor, despite living next to three of them ──
///
/// `TotpFactor`, `Passkey` and `RecoveryCode` all answer "may this person sign in".
/// This one never does: it authorises a payment on a session that is already
/// established. That distinction is why removing it does not sweep sessions the way
/// disabling a factor does — no session was ever established with it, so there is
/// nothing for a sweep to invalidate. See `PaymentPinService.disable`.
///
/// ─── Why argon2id and not the sha256+pepper every other short secret uses ───
///
/// `pepperedHash` is right for an OTP or a recovery code: high entropy, short-lived,
/// and the hash is only ever compared against a value the server itself minted. A
/// Payment PIN is the opposite — six digits is a keyspace of one million, chosen by
/// the user and held for months, so a stolen dump plus sha256 is a complete recovery
/// in under a second. It is a low-entropy user-chosen secret, which is the same shape
/// as a password, so it gets the password's hash: `CredentialService.hash`.
///
/// ─── Why disabling HARD deletes, against this file's own convention ─────────
///
/// The convention above is `deletedAt` plus a partial unique index, and it exists for
/// two reasons that both fail to apply here. `Passkey` and `User` soft-delete so a
/// retired row does not permanently reserve an external identifier — a credential ID,
/// an email address — and there is no such identifier on this table. `RecoveryCode`
/// soft-deletes so the audit trail of which code was spent survives, and this row has
/// no comparable history to keep: one hash, replaced in place by an update.
///
/// What is left of a soft delete here is the retained argon2 hash of a secret the user
/// asked us to destroy, which is a cost with no matching benefit. The audit trail is
/// the `logger.warn` and the security-changed email that every disable already sends,
/// exactly as the two factor surfaces do it. Hence a plain `@unique` rather than a
/// partial index in db/sql/identity.sql.
model PaymentPin {
  id     String @id @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// argon2id, with the pepper supplied as argon2's `secret` parameter rather than
  /// concatenated — see `CredentialService.hash` for why that distinction matters.
  ///
  /// Never returned by any endpoint, never logged, and never compared by anything but
  /// `CredentialService.verify`, which is constant-time by construction.
  pinHash String @map("pin_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Bumped by every update. The only thing that distinguishes a PIN set today from
  /// one set a year ago, and the reason an update is an UPDATE rather than a
  /// delete-and-insert: `createdAt` stays the day the PIN was first set.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payment_pins")
  @@schema("identity")
}

/// An address this account released by changing its email, and the recovery ticket
/// that goes with it.
///
/// ─── Two jobs, and they are not the same job ────────────────────────────────
///
/// RESERVATION. While a row is live nobody else may register the address. The partial
/// index on `users.email_lower` cannot do this — it constrains live accounts, and the
/// moment the change commits the old address is free by that index's own definition.
/// Reserving it is what stops a stranger claiming the address a user may still want
/// back, and what stops them receiving mail intended for the previous owner.
///
/// RECOVERY. The row carries a single-use token, mailed to the released address in the
/// "your email was changed — did you do this?" notification. Presenting it plus a code
/// sent to that same address authorises restoring the account to it, or redirecting the
/// account to a third address. That is the answer to the takeover this feature would
/// otherwise create: an attacker who changes the address away from its owner hands the
/// owner, by construction, everything needed to take it back.
///
/// ─── What this is NOT ──────────────────────────────────────────────────────
///
/// NOT a sign-in credential. `LoginService` does not consult this table and must never
/// be made to: a retained address that could request a login code would be a full
/// account takeover for whoever still controls the mailbox the user is most likely
/// changing away FROM. The capability here is exactly two operations, each of which can
/// only ever point the account at an address the token-holder has proved they control.
///
/// ─── Why no unique index on `email_lower` ──────────────────────────────────
///
/// One address may legitimately have several rows over time: retained, expired,
/// registered by somebody else, released again. Uniqueness would forbid the second
/// cycle. Availability is `expires_at > now()`, evaluated per query — never a flag a
/// cleanup job has to maintain, so correctness does not depend on that job running.
model RetainedEmail {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// As displayed, and normalised. Both, for `users`' reason: the normalised one is
  /// what every lookup matches, and the original casing is what a notification shows.
  email      String
  emailLower String @map("email_lower")

  /// When the reservation and the recovery ticket both lapse. One timestamp for both
  /// deliberately — a recovery window that outlived the reservation would let someone
  /// reclaim an address another account had meanwhile registered.
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  /// `pepperedHash(token, 'email-recovery')`.
  ///
  /// Its OWN hash domain, not the `'recovery'` used by 2FA backup codes. Domain
  /// separation is what stops a value lifted from `recovery_codes` verifying here —
  /// the same rule `HashDomain` in auth/auth.utility.ts exists to enforce.
  recoveryTokenHash String @map("recovery_token_hash")

  /// Set when the token is spent. The terminal marker, following `consumedAt`
  /// elsewhere: a spent ticket is retained, not deleted, so "was this recovered, and
  /// when" stays answerable after the fact.
  /// `@db.Timestamptz` like every other instant in this schema. It is spelled out
  /// rather than left to Prisma's default because migration
  /// `20260905160000_email_change` created this column as TIMESTAMPTZ: without the
  /// annotation Prisma believes the column should be `timestamp(3)` and proposes an
  /// `ALTER COLUMN ... SET DATA TYPE TIMESTAMP(3)` on every future migration — a
  /// conversion that rewrites existing values through the session time zone and
  /// discards the offset.
  recoveryConsumedAt DateTime? @map("recovery_consumed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// The registration and email-change availability probe: "is this address live for
  /// anyone right now".
  /// `map:` pins the name migration 20260905160000_email_change gave it. Without it
  /// Prisma renames the index to its own default on the next migration.
  @@index([emailLower, expiresAt], map: "ix_retained_emails_lookup")
  /// This account's own live retention, for the status screen and for deciding whether
  /// a previous address must also authorise the next change.
  @@index([userId, expiresAt], map: "ix_retained_emails_user")
  @@map("retained_emails")
  @@schema("identity")
}

/// A username this account released by changing it, and how long it stays reserved.
///
/// `RetainedEmail`'s twin, and deliberately the smaller of the two: there is no
/// recovery ticket here. An address is a channel every other recovery path mails to, so
/// releasing one has to be undoable by whoever still holds the mailbox. A username is an
/// identifier, not a channel — nothing is delivered to it — so the row only has to
/// answer "is this taken", and the owner's route back is the ordinary change endpoint.
///
/// ─── RESERVATION ────────────────────────────────────────────────────────────
///
/// While a row is live nobody may take the username — not another account changing to
/// it, and not a new signup being allocated one. `ix_users_username_active` cannot do
/// this: it constrains LIVE accounts, and the moment a change commits the old username
/// is free by that index's own definition. Exactly the argument on `RetainedEmail`.
///
/// ─── Why no unique index on `username_lower` ────────────────────────────────
///
/// One username may legitimately have several rows over time: reserved, expired, taken
/// by somebody else, released again. Uniqueness would forbid the second cycle. Liveness
/// is `expires_at > now()`, evaluated per query — never a flag a cleanup job has to
/// maintain, so correctness does not depend on that job running, and there is no job.
///
/// ─── Why rows are KEPT after they expire ────────────────────────────────────
///
/// Load-bearing twice over. It is what makes `created_at` a change ledger, and that
/// ledger is what makes the free-change allowance authoritative in Postgres rather than
/// in Redis — which matters because that allowance gates money. A row costs two short
/// strings; a Redis flush handing out free changes costs revenue.
///
/// ─── The two retention lengths ──────────────────────────────────────────────
///
/// `expires_at` is set from one question asked at change time: does this account have
/// any live reservation right now? No — this is the first change in a sequence, so the
/// released username is held for `USERNAME.RETENTION_DAYS`. Yes — the account is
/// mid-churn, so it is held for `USERNAME.RELEASE_SECONDS` and comes back in minutes.
///
/// An existing row's `expires_at` is NEVER renewed, so the first reservation's deadline
/// is fixed at the change that created it and cannot be extended by later churn. That
/// is the whole of the product rule: only the first previous username is held for
/// thirty days, and the intermediate ones are not.
model UsernameReservation {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// As displayed, and normalised. Both, for `users`' reason: the normalised one is
  /// what every lookup matches, and the original casing is what the status screen shows.
  username      String
  usernameLower String @map("username_lower")

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// The availability probe every claim path runs: "is this username reserved for
  /// anyone right now". Ordinary, NOT unique — see the note above.
  @@index([usernameLower, expiresAt], map: "ix_username_reservations_lookup")
  /// Two questions, one index: how many changes has this account made inside the free
  /// window (the quota), and does it hold a live reservation (the retention length).
  ///
  /// `sort: Desc` and `map:` both restate what migration 20260907120000 actually
  /// created — `(user_id, created_at DESC)` named `ix_username_reservations_user`.
  /// Omitting either makes Prisma see a different index and propose dropping and
  /// recreating this one.
  @@index([userId, createdAt(sort: Desc)], map: "ix_username_reservations_user")
  @@map("username_reservations")
  @@schema("identity")
}

/// THE sign-in state machine: one row per in-flight login, start to finish.
///
/// ─── What this table is for ─────────────────────────────────────────────────
///
/// A sign-in is several requests long, and the state between them has to live
/// somewhere. It must NOT be an access token — anything the client can present as
/// a bearer would make the remaining factors optional to whoever holds it. So it
/// is a server-side row, and the client holds only an opaque handle (`loginId`)
/// pointing at it.
///
/// ─── It now covers the WHOLE flow, not just the second factor ───────────────
///
/// This table used to be opened only when a first factor had already succeeded
/// and a second was owed. Everything before that point was identified by the
/// caller re-sending a public identifier — an email address — on each request,
/// which is not a credential and never was: it named the account rather than
/// proving anything about the person asking.
///
/// The row is now opened by `POST /auth/login {step:'start'}`, before any
/// credential is presented, and the same handle carries through the first factor
/// and the second to `POST /auth/2fa/verify`. One flow, one row, one handle. What
/// that buys, concretely: `otp-verify` no longer takes an address from the body,
/// so a caller cannot point a live flow at a different account by editing a
/// field, and every step resolves through one gate rather than four lookups with
/// four sets of rules.
///
/// ─── Two names for one value, deliberately ──────────────────────────────────
///
/// On the wire the handle is `loginId`. At rest it is `tokenHash`, and the hash
/// domain mixed into the digest is `'mfa'` (see `pepperedHash`). Those internal
/// names are NOT updated to match the public one, for the same reason the admin
/// service kept `stepUpSecretHash` when its wire name became `loginId`: a third
/// name for one value is worse than two, and the domain tag is part of the digest
/// — changing it would invalidate every live row at deploy for no security gain.
/// The `Id` suffix is also misleading in the one way that matters: this is 256
/// bits of CSPRNG output and the only thing standing between a stranger and a
/// half-authenticated sign-in. It is a credential, not a row id.
model LoginAttempt {
  id String @id @db.Uuid

  /// Null until a factor identifies the account.
  ///
  /// The flow is opened anonymously — `start` knows nothing about who is signing
  /// in — and this is filled by the step that first resolves an identifier to a
  /// real user. From that moment it is the ONLY source of identity for the rest
  /// of the flow: no later step reads a user from the request body, which is what
  /// makes "a login flow cannot be switched between users" structural.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Peppered hash of the `loginId` handed to the client. The plaintext is never
  /// stored, for the same reason the continuation secret's is not: this row is what
  /// a stranger would need to finish somebody else's sign-in.
  ///
  /// Nullable so it can be RETIRED. `completeAttempt` nulls it in the same
  /// statement that sets `completedAt`, so there is no interval in which a spent
  /// handle is still matchable. Uniqueness among live rows is the partial index
  /// `ux_login_attempts_token_live` in db/sql/identity.sql.
  tokenHash String? @map("token_hash")

  /// The identifier the caller attempted, normalised.
  ///
  /// Recorded so `otp-verify` does not have to ask for it a second time. It is
  /// deliberately kept even when it resolved to no account: `requestOtp` answers
  /// identically for a known and an unknown address, and it can only keep doing
  /// that if the follow-up step works the same way in both cases.
  identifierLower String? @map("identifier_lower")

  state LoginState @default(STARTED)

  /// Wrong second-factor guesses. On the row rather than only in Redis so the cap
  /// survives a cache flush — see MFA.MAX_ATTEMPTS.
  attempts Int @default(0)

  /// Carried across the flow because the session is minted at the END of it, by
  /// which point the request that proved the password is long gone. Without these
  /// the later steps could not tell whether the browser is trusted, and every
  /// sign-in with 2FA on would silently lose remember-me.
  ///
  /// They are also the binding: `assertSameContext` refuses a handle presented
  /// from a different device or network class than the one that opened the flow.
  ipClass           String  @map("ip_class")
  deviceFingerprint String  @map("device_fingerprint")
  userAgent         String? @map("user_agent") @db.VarChar(256)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Absolute, stamped at `start` from `LOGIN_FLOW.TTL_SECONDS`. Re-stamped ONCE,
  /// on the transition into FACTOR_REQUIRED, to the MFA ceremony budget — a state
  /// transition rather than a sliding window, so repeating a request cannot extend
  /// the flow indefinitely.
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  @@index([userId, state])
  @@map("login_attempts")
  @@schema("identity")
}

enum LoginState {
  /// Flow open, nobody identified yet. What `step:'start'` creates.
  STARTED
  /// A passwordless sign-in code has been emailed. Reached from STARTED by
  /// `otp-request`, and the only state `otp-verify` is legal from.
  OTP_SENT
  /// First factor accepted; a second is owed. The only state a factor may be
  /// proven from.
  FACTOR_REQUIRED
  /// A session was issued. Terminal.
  COMPLETED
  /// Ran out of time, was superseded, or burned its attempts. Terminal.
  EXPIRED

  @@schema("identity")
}

/// The factor KINDS that have a table. `recovery_code` is a sign-in method on the
/// wire but not a member here — a recovery code is a spent string, not something
/// a user enrols, and nothing in Postgres needs to name it.
enum MfaMethod {
  TOTP
  PASSKEY

  @@schema("identity")
}

/// One row per rotation *generation* in a refresh chain. `familyId` is constant
/// across every rotation (it is the id of the first generation), so presenting an
/// already-rotated refresh token can revoke the entire chain at once.
///
/// There is deliberately no `tokenHash` column. The service issues a signed
/// access/refresh JWT pair and stores neither half; this row is what a token
/// *points at*, and its only jobs are to make a generation revocable and to make
/// a replay detectable.
///
/// `expiresAt` is the refresh token's expiry, and therefore the session's. The
/// access token's fifteen minutes live only in its `exp` claim — there is nothing
/// to store for it, and storing it would imply it were revocable within those
/// fifteen minutes, which it is not.
///
/// `revokedAt` is this table's archival column and is deliberately not called
/// `deletedAt`: a revoked session is kept forever and stays queryable. A second
/// nullable timestamp meaning almost the same thing would only invite the two to
/// disagree.
model Session {
  id       String @id @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String @map("family_id") @db.Uuid
  /// Null on the first generation of a family.
  parentId String? @map("parent_id") @db.Uuid

  /// Opaque ID in a persistent, HttpOnly browser-profile cookie. It groups tabs
  /// for device-scoped logout; it never authorises a request.
  deviceFingerprint String  @map("device_fingerprint")
  /// /24 for IPv4, /48 for IPv6. The prefix rather than the address, so a mobile
  /// client that changes IP mid-session is not treated as a new device.
  ipClass           String  @map("ip_class")
  /// ─── THE OBSERVED COUNTRY, AND WHAT IT IS NOT ────────────────────────────
  ///
  /// ISO 3166-1 alpha-2 for the address this generation was seen from, resolved
  /// through `GeoResolver`. This is EVIDENCE — where the network says the request came
  /// from — and it is the only country signal the security-context evaluator may read.
  ///
  /// It is emphatically NOT `users.country_declared`, which the user types and which
  /// that column's own comment rules out as evidence of anything. It is also not
  /// `users.country_ip`, which is written once at account creation and never updated,
  /// so it is a stale convenience rather than a history.
  ///
  /// History is exactly what the evaluator needs — "has this account been seen from
  /// this country before?" — and a history needs one row per observation. That is this
  /// column, on the table that already carries the other two signals it is compared
  /// alongside (`ip_class`, `device_fingerprint`), so all three answer to one query
  /// shape and one index shape.
  ///
  /// Written on `createFirstGeneration` AND on every `rotate`, tracking `ip_class`,
  /// which a rotation already updates to the current request's value. A session that
  /// roams therefore records each country it moves through rather than freezing the one
  /// it started in.
  ///
  /// NULL is the normal value today and is never a guess: `NullGeoResolver` is the
  /// shipped implementation, and the port's contract is to return null rather than
  /// invent a country when a lookup is unavailable. Every row written before a real
  /// provider is bound stays null, and it cannot be backfilled — which is why the
  /// column ships before the provider does, exactly as `users.country_ip` did.
  country           String? @db.Char(2)
  userAgent         String? @map("user_agent") @db.VarChar(256)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz

  /// Last authenticated request on this session. Written by AuthGuard, throttled —
  /// see SESSION.LAST_USED_THROTTLE_SECONDS.
  ///
  /// This ANCHORS the idle window. `expiresAt` is still the column every reader
  /// enforces, but the two move together: `SessionDbOperation.touch` writes both,
  /// and a rotation computes the child's expiry from this value rather than from
  /// the clock. That is what makes a refresh not count as activity — before it did,
  /// and a client refreshing in the background renewed a 24-hour window forever.
  ///
  /// Copied UNCHANGED onto the child at rotation. The `now()` default is for
  /// inserts only; letting it apply to a child would restart the idle clock on
  /// every refresh and undo the whole mechanism.
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz

  /// Non-null when this session sits on a trusted device. Until this moment the
  /// idle rule is suspended. Stamped once at trust time and copied UNCHANGED
  /// through every rotation — a rotation that recomputed it would make the window
  /// infinite, and nothing about the session would look wrong.
  ///
  /// Copied only while the trust still holds on the request doing the rotating: a
  /// refresh arriving without that browser's device cookie drops to null and the
  /// session continues on the ordinary idle rule. See `SessionService.honourTrust`.
  rememberUntil DateTime? @map("remember_until") @db.Timestamptz

  /// The trusted-device row that authorised `rememberUntil`. What lets "untrust
  /// this device" find every session that trust is holding open.
  ///
  /// Re-read from the live trust row at each rotation rather than copied, so a
  /// device that was untrusted and trusted again points at the new row instead of
  /// the revoked one. Null whenever `rememberUntil` is.
  trustedDeviceId String?        @map("trusted_device_id") @db.Uuid
  trustedDevice   TrustedDevice? @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)

  /// Set once this generation has been exchanged for a child. A second exchange
  /// is by definition a replay.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  /// LOGOUT | LOGOUT_ALL | REUSE_DETECTED | PASSWORD_RESET | PASSWORD_CHANGED
  /// | PASSKEY_DISABLED | TOTP_DISABLED
  revokedReason String? @map("revoked_reason") @db.VarChar(32)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([trustedDeviceId])
  @@map("sessions")
  @@schema("identity")
}

/// A browser profile the user has explicitly asked to be remembered.
///
/// The `orebit_device` cookie holds a random secret; only its peppered hash is
/// stored, here and on `Session.deviceFingerprint`. That one shared value does
/// two jobs: it groups the tabs of one browser for device-scoped logout, and it
/// is the join key for trust. Storing the hash rather than the plaintext is what
/// keeps a database dump from yielding usable device secrets.
///
/// Trust is a session extension, never an authentication factor — a device token
/// alone can no more sign you in than a cookie can.
model TrustedDevice {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// pepperedHash(cookie secret, 'device'). The plaintext lives only in the cookie.
  tokenHash String @map("token_hash")

  /// Corroboration, never a gate. Browsers change their user-agent on every
  /// update, so a mismatch is logged and surfaced — never grounds to revoke.
  userAgentAtTrust String? @map("user_agent_at_trust") @db.VarChar(256)
  ipClassAtTrust   String  @map("ip_class_at_trust")
  /// Human label for the device list, derived from the user-agent at trust time.
  label            String? @db.VarChar(80)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  sessions Session[]

  @@index([userId, revokedAt])
  @@map("trusted_devices")
  @@schema("identity")
}

/// The resumable registration state machine. `id` doubles as the `registrationId`
/// handed to the client, and is the credential for every subsequent step.
///
/// No unique constraint on email here, deliberately: this row is pre-account and
/// disposable, and several abandoned attempts for one address are normal. The real
/// uniqueness guarantee is on `User`.
model Registration {
  id    String            @id @db.Uuid
  email String
  /// Normalised copy, so a resumed attempt matches regardless of how it was typed
  /// the second time.
  emailLower String            @map("email_lower")
  state      RegistrationState @default(OTP_SENT)
  /// Argon2id hash captured at `credentials`; cleared in the final account-creation transaction.
  pendingPasswordHash String? @map("pending_password_hash")

  /// sha256 of the continuation secret the client holds as `signupId`.
  ///
  /// This is what identifies an in-flight registration, and it replaced a
  /// client-supplied `registrationId`. The distinction that matters, and it is
  /// not the transport: the row's primary key never leaves the server, so a
  /// leaked response body cannot be used to drive somebody else's signup. Only
  /// the HASH is stored, for the same reason passwords are hashed — a database
  /// leak must not hand over live credentials.
  ///
  /// It used to travel in the httpOnly `orebit_reg` cookie, with
  /// `x-registration-token` as an alternate transport for native clients. Both
  /// are gone; the value is a field in the request body now, which is why it is
  /// named `signupId` on the wire while the column keeps the name that describes
  /// what it holds.
  ///
  /// Nulled on completion and on expiry: a spent secret is not a credential any
  /// more, and leaving it behind would only be a thing to leak. Completion nulls
  /// it inside `UserDbOperation.createAccount`'s transaction, in the same
  /// statement that sets `completedAt` — so there is no interval in which a
  /// finished signup still has a matchable handle, rather than relying on every
  /// finder remembering to filter. Uniqueness among live rows is the partial
  /// index `ix_registrations_continuation` in db/sql/identity.sql.
  continuationSecretHash String? @map("continuation_secret_hash")

  /// sha256 of the current code plus the pepper. Null once verified — a verified
  /// registration has no live code, and leaving the hash behind would only be a
  /// thing to leak.
  otpHash      String?   @map("otp_hash")
  otpExpiresAt DateTime? @map("otp_expires_at") @db.Timestamptz
  /// Counted on the row, not only in Redis, so the cap survives a cache flush.
  otpAttempts  Int       @default(0) @map("otp_attempts")
  otpSentCount Int       @default(1) @map("otp_sent_count")
  lastOtpSentAt DateTime? @map("last_otp_sent_at") @db.Timestamptz

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz

  /// Whether the user set a password rather than skipping it. Recorded here as
  /// well as implied by the Credential row, because the state machine needs to
  /// know what happened at this step without joining.
  passwordSet Boolean @default(false) @map("password_set")

  /// The referral code as entered. Copied to `User.referredByCode` at account
  /// creation. Stored even when it did not match anything — an unmatched code is
  /// accepted and ignored rather than blocking a signup.
  referralCodeEntered String? @map("referral_code_entered")

  /// Answer to "trust this device?", asked before the country step. Defaults to
  /// false so a client that never sends the step — an older frontend, or a user
  /// who dismissed it — gets an ordinary untrusted session rather than a silent
  /// week-long one. Read by `setCountry`, which issues the first session.
  trustDevice Boolean @default(false) @map("trust_device")

  /// What the geo lookup suggested, versus what the user actually chose. Both are
  /// kept: the pair is the only evidence of whether users accept the suggestion.
  countrySuggested String? @map("country_suggested") @db.Char(2)
  country          String? @db.Char(2)

  ipAddress String @map("ip_address") @db.Inet

  /// Set once the account exists. From that point this row is history.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  completedAt DateTime? @map("completed_at") @db.Timestamptz
  /// Whole-attempt TTL. An abandoned registration expires rather than lingering
  /// as a resumable half-account.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  /// Set when the attempt began at a provider rather than at `step: start`. The
  /// OauthLink row is written at account creation, in the same transaction as the
  /// User — carrying the provider identity HERE rather than in a cookie or a
  /// signed blob is what preserves the state machine's "a client cannot skip a
  /// step" property for the social path too.
  ///
  /// `oauthEmailVerified` records whether the PROVIDER asserted the address was
  /// verified. False routes the attempt through our own OTP regardless of what the
  /// provider returned.
  oauthProvider      OauthProvider? @map("oauth_provider")
  oauthSubject       String?        @map("oauth_subject")
  oauthEmailVerified Boolean        @default(false) @map("oauth_email_verified")
  oauthAvatarUrl     String?        @map("oauth_avatar_url")

  @@index([emailLower])
  @@index([state])
  @@index([oauthProvider, oauthSubject])
  @@map("registrations")
  @@schema("identity")
}

enum RegistrationState {
  OTP_SENT
  OTP_VERIFIED
  /// Password choice is recorded, but no User exists until the country step.
  CREDENTIALS_SET
  /// Retained for legacy in-progress rows created before final-step account creation.
  ACCOUNT_CREATED
  COMPLETED
  EXPIRED

  @@schema("identity")
}

/// One row per linked provider identity. `(provider, subject)` is the provider's
/// own stable id for the person — never their email, which they can change.
///
/// Uniqueness on `(provider, subject)` is a partial index for the same reason as
/// User's: unlinking is a soft delete, and a plain constraint would permanently
/// bar the owner from re-linking that same account.
///
/// No provider access or refresh token is stored. The authorization code is
/// exchanged once, server-side, read for the profile, and discarded — which is
/// also why this table needs no encryption envelope.
model OauthLink {
  id       String        @id @db.Uuid
  userId   String        @map("user_id") @db.Uuid
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider OauthProvider
  subject  String

  /// Provenance only — `User.email` stays authoritative. Kept so a support
  /// question about which address a provider asserted is answerable.
  emailAtLink             String?  @map("email_at_link")
  emailVerifiedByProvider Boolean  @default(false) @map("email_verified_by_provider")
  avatarUrlAtLink         String?  @map("avatar_url_at_link")
  /// The display name the provider asserted at link time, for the Settings screen.
  ///
  /// Provenance like the two fields above, and nullable for two distinct reasons
  /// that both stay true: Apple publishes no name in its ID token and has no
  /// endpoint to fetch one, and rows written before this column existed have none.
  /// A settings screen therefore falls back to the address, then the provider name.
  nameAtLink              String?  @map("name_at_link")
  linkedAt                DateTime @default(now()) @map("linked_at") @db.Timestamptz
  lastLoginAt             DateTime? @map("last_login_at") @db.Timestamptz

  /// When the owner asked for this link to go away, and when it actually will.
  ///
  /// Both null on every ordinary link. Unlinking is deliberately NOT immediate: the
  /// request stamps these two and nothing else, so the link stays FULLY LIVE and the
  /// provider keeps signing the owner in for the whole waiting period. See
  /// `SOCIAL_UNLINK.DELAY_DAYS`.
  ///
  /// `deletedAt` below remains the one column that decides whether a link resolves.
  /// Nothing on the sign-in path reads these two, which is what keeps the delay out
  /// of `findOauthLink` — the login flow is unchanged until the row is actually
  /// retired. `SocialUnlinkSweeper` sets `deletedAt` once `unlinkAt` has passed, and
  /// leaves these in place afterwards as the record of why the row died.
  ///
  /// One pending unlink per account per provider is free rather than enforced here:
  /// `ix_oauth_links_user_provider_active` already permits only one live row to
  /// stamp, so a second click has nowhere else to write.
  ///
  /// Cleared together, by exactly one path — re-linking the SAME provider identity,
  /// which is how a mis-clicked unlink is taken back. See `OauthService.attachToAccount`.
  unlinkRequestedAt       DateTime? @map("unlink_requested_at") @db.Timestamptz
  unlinkAt                DateTime? @map("unlink_at") @db.Timestamptz

  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz

  @@index([userId])
  @@index([provider, subject])
  /// The sweep's only query: which live links are due to be retired.
  @@index([unlinkAt])
  @@map("oauth_links")
  @@schema("identity")
}

/// All five are listed now even though only GOOGLE has an adapter. Adding a
/// provider then costs no migration — and this enum is referenced by
/// `Registration`, so widening it later would touch two tables.
enum OauthProvider {
  GOOGLE
  X
  TELEGRAM
  APPLE
  FACEBOOK

  @@schema("identity")
}

/// Post-account one-time codes: login for accounts with no password, and password
/// reset.
///
/// Kept separate from `Registration.otpHash` rather than generalised into one
/// table, because the two have different lifetimes and different owners — a
/// registration OTP belongs to a pre-account row that expires wholesale, and this
/// one belongs to a real user and must be auditable after the fact.
///
/// `consumedAt` is the terminal marker, following `Session.revokedAt`: spent
/// challenges are retained, not deleted.
model VerificationChallenge {
  id      String           @id @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose ChallengePurpose

  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz

  /// The address the code was requested from. Recorded so the "reset came from an
  /// unusual IP" rule the product wants can be added without a backfill — there
  /// is nothing enforcing it yet, since there are no debit paths to restrict.
  ipAddress String   @map("ip_address") @db.Inet

  /// WHERE the code was mailed, normalised — not to be confused with `ipAddress`,
  /// which is where it was requested FROM.
  ///
  /// Null for every purpose that mails the account's own address, which is all three
  /// original ones: the recipient is `user.email` and the row needs no second copy of
  /// it. Set only by the email-change purposes, where the whole point is that the code
  /// went somewhere the account does not yet own.
  ///
  /// Without it, a code mailed to the CURRENT inbox could be spent as the proof for
  /// the NEW address and the ceremony would prove nothing — `verifyChallengeCode`
  /// keys on `(userId, purpose)` and would happily accept it. See
  /// `EmailChangeService.verify`.
  targetEmailLower String? @map("target_email_lower")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, purpose, consumedAt])
  @@map("verification_challenges")
  @@schema("identity")
}

enum ChallengePurpose {
  LOGIN_OTP
  PASSWORD_RESET
  /// An emailed code proving the mailbox before a credential is changed — adding or
  /// removing a second factor, or changing a password.
  ///
  /// Its OWN purpose rather than reusing PASSWORD_RESET, and that is load-bearing:
  /// `ChallengeDbOperation.issue` supersedes any live row for the same
  /// (user, purpose) inside a transaction, so sharing would mean starting a factor
  /// change silently invalidated a password reset the user had in flight.
  CREDENTIAL_CHANGE

  /// ─── the three email-change codes ─────────────────────────────────────────
  ///
  /// One purpose per ROLE, and that is forced rather than stylistic. `ux_challenges_live`
  /// is unique on `(user_id, purpose) WHERE consumed_at IS NULL`, and `issue` supersedes
  /// any live row for the pair BEFORE inserting — so two codes sharing a purpose is not
  /// a constraint violation, it is the first code silently dying while the user is told
  /// two were sent. Three roles therefore need three purposes.
  ///
  /// They are also why the surrounding feature can exist at all with the index
  /// untouched: three slots is exactly what an email change needs, because retention
  /// (30 days) equals the change window (30 days) and each change retains one address,
  /// so at most one previous address is ever live at a change. `EmailChangeService`
  /// asserts that invariant rather than assuming it.

  /// The code mailed to the address the account holds right now.
  EMAIL_CHANGE_CURRENT
  /// The code mailed to the address being claimed. Carries `targetEmailLower`.
  EMAIL_CHANGE_NEW
  /// The code mailed to a still-retained previous address, which must also authorise
  /// the change while its retention is live. Carries `targetEmailLower`.
  EMAIL_CHANGE_RETAINED

  /// The code mailed to a DELETED account's own address to reactivate it.
  ///
  /// Its own purpose for the reason CREDENTIAL_CHANGE states: `issue` supersedes any
  /// live row for the same (user, purpose) pair, so sharing LOGIN_OTP would mean a
  /// reactivation request silently killing a login code, and — far worse — would let a
  /// code obtained from the ordinary login flow reactivate an account. Reactivation is
  /// meant to be an explicit act, so the code that authorises it must not be one the
  /// user could have been talked into requesting for something else.
  ACCOUNT_REACTIVATION

  /// The code mailed to confirm a user rain the rain security policy asked to verify.
  /// Its own purpose so it never retires a password reset or credential change in flight.
  RAIN_CONFIRM

  @@schema("identity")
}

/// The email blocklist — one row is one rule, checked on signup and on signin.
///
/// This is the temp-mail control. It is a table rather than a list in code
/// because the rules change on an operator's timescale, not a deploy's: a new
/// disposable provider appears and someone has to be able to shut it out this
/// afternoon. `auth/services/blocklist.service.ts` is the only reader.
///
/// No admin write surface exists yet — `createdBy` is here so that when one
/// lands, adding it is a route and a guard rather than a migration. Rows come
/// from db/seed.ts until then.
model BlockedEmail {
  id String @id @db.Uuid

  /// How `value` is matched. Derived from `value` at write time rather than
  /// supplied independently, so the two can never disagree — see
  /// `BlocklistDbOperation.block`.
  kind BlockedEmailKind

  /// Normalised at write time: trimmed and lowercased. A full address for EMAIL,
  /// a bare domain for DOMAIN — no `@`, no leading dot.
  ///
  /// Unique globally rather than per-kind, which is safe because the two value
  /// spaces cannot collide: an EMAIL value contains `@` and a DOMAIN value never
  /// does. That lets a lookup be one `value IN (…)` against one index instead of
  /// a query per kind.
  value String @unique(map: "ux_blocked_emails_value")

  /// Why it was blocked, for whoever reads this table in six months. Never shown
  /// to the blocked user — they get the same generic refusal either way.
  reason String? @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// The admin who added the rule, once there is an admin surface to record one.
  /// Null for seeded rows.
  createdBy String? @map("created_by") @db.Uuid

  @@map("blocked_emails")
  @@schema("identity")
}

enum BlockedEmailKind {
  /// Matches exactly one address.
  EMAIL
  /// Matches the domain and everything under it: `mailinator.com` also blocks
  /// `team.mailinator.com`. Temp-mail providers hand out wildcard subdomains, so
  /// exact-only matching would be evaded by construction.
  DOMAIN

  @@schema("identity")
}

/// One outbound email, and what the relay said about it — gap M10.
///
/// Append-only, and deliberately not linked to `User`: registration codes go out
/// before a user row exists, and a nullable FK would suggest a join that is never
/// useful. The recipient address is the key you actually search by when someone
/// says a code never arrived.
///
/// No `deletedAt`. This is an audit trail; it ages out by retention policy, not by
/// soft delete.
model MailDelivery {
  id String @id @db.Uuid

  /// The queue job this attempt belongs to.
  ///
  /// One row per ATTEMPT, not per message, so this is what ties them together: a
  /// message that failed twice and then succeeded is three rows sharing a `jobId`.
  /// Without it, "the user says the code never arrived" could only be answered with a
  /// single final state that hid the retries — and which relay eventually took it.
  ///
  /// Deliberately NOT the Redis stream entry id: a retry is a new `XADD`, so that id
  /// changes between attempts and could not correlate them.
  ///
  /// Nullable because rows written before the queue existed have no job.
  jobId   String? @map("job_id") @db.Uuid
  /// Which attempt this was, 1-based. Null for pre-queue rows.
  attempt Int?

  /// The address as sent to. Not lowercased — this is what the relay was told.
  recipient String
  /// Which template: `otp`, `password-reset`, `security-changed`, `welcome`,
  /// `new-device-login`.
  kind      String @db.VarChar(32)
  subject   String @db.VarChar(256)

  status MailDeliveryStatus
  /// `primary` | `backup`, or null when nothing was dialled.
  transport String? @db.VarChar(16)
  /// The relay's message id, when it gave one. What a postmaster asks for.
  messageId String? @map("message_id")
  /// The relay's literal reply, or the described error. Truncated at 500.
  response  String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipient, createdAt])
  @@index([status, createdAt])
  /// "Show me every attempt at this message" — the query the retry loop made
  /// necessary, and the reason `jobId` exists.
  @@index([jobId, attempt])
  @@map("mail_deliveries")
  @@schema("identity")
}

enum MailDeliveryStatus {
  /// Handed to a relay that accepted it.
  SENT
  /// A relay answered, and refused this recipient. Retrying elsewhere will not help.
  REJECTED
  /// No relay would take it — connection, timeout, or auth. Worth retrying.
  FAILED
  /// The console transport. Nothing was dialled; the code is in the log.
  SKIPPED
  /// The one-time code it carried expired before any relay would take it, so nothing
  /// was dialled. Terminal, and distinct from FAILED: the message did not fail to
  /// send, it was deliberately not sent. Its own status because "the user never got
  /// their code" and "we refused to post a code that had already died" are different
  /// answers to a support ticket, and only the second one is working as intended.
  EXPIRED

  @@schema("identity")
}

/// Immutable, versioned snapshots of the user-auth rate-limit policy.
///
/// There is intentionally no user-facing writer in this service: this table is the
/// persistence seam for the protected admin surface, which has separate
/// authentication requirements. Every update creates a new row with its actor and
/// timestamp; rollback activates a previous snapshot by copying it into a new row.
model RateLimitPolicyVersion {
  id      String @id @db.Uuid
  version Int    @unique
  policy  Json
  actor   String @db.VarChar(128)
  active  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// `sort: Desc` and `map:` restate what migration 20260902110000 created —
  /// `(active, version DESC)` named `ix_rate_limit_policy_versions_active`. Omitting
  /// either makes Prisma propose dropping and recreating it under a default name.
  @@index([active, version(sort: Desc)], map: "ix_rate_limit_policy_versions_active")
  @@map("rate_limit_policy_versions")
  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────────
// identity — the security restriction engine
//
// Three tables and one rule about how they relate:
//
//   security_restriction_policies          WHAT IS IN FORCE. Admin-owned. One row
//                                          per (action, context). The only authority.
//   security_restriction_policy_versions   WHAT WAS IN FORCE. Append-only log.
//                                          Never consulted to decide anything.
//   user_feature_restrictions              WHAT WAS DONE TO ONE ACCOUNT. Written by
//                                          this service, inside the sensitive
//                                          mutation's own transaction.
//
// Configuration and consequence are deliberately separate tables: an Admin configures
// policy and never reaches into a user's restrictions, and this service applies policy
// and never writes configuration.
// ─────────────────────────────────────────────────────────────────────────────

/// ═══ THE POLICY IN FORCE ════════════════════════════════════════════════════
///
/// One row per (trigger action, security context). With eight actions and two
/// configurable contexts that is at most sixteen rows, ever.
///
/// ─── THIS TABLE IS THE ONLY ANSWER TO "WHICH POLICY IS ACTIVE" ─────────────
///
/// There is no `active` flag here, and its absence is the design rather than an
/// omission. `@@unique([action, context])` means a pair names exactly one row, so
/// "which policy applies to a password change from a new context" is answered by a
/// lookup that cannot return two rows and cannot return an ambiguous one. A flag would
/// be a second authority that could disagree with the constraint, and then "active"
/// would be a value someone could get wrong.
///
/// Contrast `RateLimitPolicyVersion` above, which is store and history in ONE table
/// and therefore MUST carry `active` to disambiguate its rows. That design is right
/// there — it holds a single global document and rollback means re-activating an old
/// snapshot — and it is the design being deliberately avoided here, because sixteen
/// independently-editable rows in one versioned table would make every edit rewrite
/// all sixteen and make two admins editing different actions collide on one document.
///
/// ─── The invariant that binds this to the history table ───────────────────
///
///   For every (action, context), this row is byte-identical to the newest
///   `SecurityRestrictionPolicyVersion` row with the same (action, context).
///
/// Every accepted write updates this row and appends exactly one history row carrying
/// the SAME resulting state, in one transaction. So history is a log of what this
/// table has held, never a competing copy — and `UserFeatureRestriction.policyVersion`
/// resolves to exactly one history row showing what was in force at the time.
///
/// ─── No seeding, and no code-level default ────────────────────────────────
///
/// A pair with no row restricts nothing. That is the safe state and it is the state a
/// fresh database is in: nothing here is seeded, and the policy snapshot service holds
/// no fallback, so Postgres is the only place a restriction can be configured and a
/// value in code can never disagree with it.
///
/// ─── No `deletedAt` ───────────────────────────────────────────────────────
///
/// `enabled` already says "off", and two ways to say the same thing is a bug
/// generator — `AdminCaptchaProvider`'s argument, and it applies unchanged.
model SecurityRestrictionPolicy {
  id String @id @db.Uuid

  /// A `TRIGGER_ACTIONS` member from src/restrictions/restrictions.catalogue.ts.
  ///
  /// Varchar rather than a Prisma enum, following `AdminAuthEvent.eventType` and
  /// `AdminCaptchaProvider.provider`: adding a trigger should not be a migration on a
  /// table nothing gates on, and a value outside the registry simply matches nothing
  /// and is dropped with a warning on read.
  action String @db.VarChar(48)

  /// A `POLICY_CONTEXTS` member — `COMMON_IP_DEVICE` or `NEW_CONTEXT`.
  ///
  /// `UNCLASSIFIED` is NOT storable here and must never become so. It is a conclusion
  /// the evaluator reaches, not a context an operator configures; a request that
  /// reaches it has `NEW_CONTEXT`'s policy applied and is RECORDED as unclassified on
  /// the restriction row. Admitting it here would ask an Admin to configure a third
  /// policy for a state defined as "we could not tell", and would let them configure it
  /// more leniently than the strict one it is supposed to fall back to.
  context String @db.VarChar(32)

  /// Default OFF. A row that exists but has never been deliberately switched on must
  /// restrict nothing — the same direction the missing-row case already fails in, so
  /// there is one safe answer rather than two that have to agree.
  enabled Boolean @default(false)

  /// Feature ids restricted in whole. Each is a `PLATFORM_FEATURES` key.
  features String[] @default([])

  /// Sub-feature ids restricted individually, QUALIFIED BY THEIR PARENT as
  /// `<featureId>/<subFeatureId>`.
  ///
  /// ═══ WHY THESE ARE NOT BARE SUB-FEATURE IDS ═════════════════════════════
  ///
  /// Two features may legitimately declare a sub-feature with the same name, so a bare
  /// id identifies nothing. Stored bare, a selection could not be validated — the
  /// catalogue's `isSubFeatureOf` takes both halves precisely because one half is
  /// ambiguous — and the engine could write a restriction row for a target that does
  /// not exist and that nothing would ever match.
  ///
  /// The delimiter is `/`, and feature and sub-feature ids may not contain it. That is
  /// a constraint on the hierarchy this column is validated against, enforced at the
  /// DTO boundary rather than by the database.
  ///
  /// Redundancy with `features` is legal and harmless: if a feature is listed whole,
  /// its sub-features are already covered and listing them too changes nothing. What
  /// applies is the union.
  subFeatures String[] @default([])

  /// How long the restriction lasts, in whole seconds.
  ///
  /// Seconds, matching every other duration in this repository — `OTP.TTL_SECONDS`,
  /// `LOCKOUT.DURATION_SECONDS`, `SESSION.ABSOLUTE_TTL_SECONDS`, the wire's
  /// `retryAfterSeconds`. Nothing anywhere stores a value alongside a unit.
  ///
  /// The Admin surface accepts `{ value, unit }` in minutes, hours or days and
  /// normalises here at the DTO boundary, so there is one stored number and no second
  /// field that could disagree with it. The round-trip is knowingly lossy: an operator
  /// who enters "90 minutes" is shown the canonical rendering of 5400 seconds.
  ///
  /// ─── The floor is a DATABASE constraint, not just validation ────────────
  ///
  /// `ck_security_restriction_policies_duration_positive` in db/sql/identity.sql
  /// enforces `duration_seconds > 0`. Prisma cannot express a CHECK, which is exactly
  /// why it lives there rather than here.
  ///
  /// It is worth a real constraint because the failure is silent and it fails OPEN: a
  /// zero or negative duration yields `expires_at <= starts_at`, so the row is already
  /// expired the instant it is written and the feature is never actually restricted.
  /// Nothing would log, nothing would 500, and the restriction would simply not happen.
  ///
  /// DTO validation alone is not enough because it is not the only writer this table
  /// will ever see — `AdminCaptchaProvider` records that settings rows in this platform
  /// get hand-written in psql during incidents, and that is precisely when a typo is
  /// most likely and least likely to be noticed.
  ///
  /// No maximum is enforced at this level. The product has not set one, and inventing
  /// a ceiling here would be a policy decision buried in DDL; the Admin DTO is where it
  /// belongs once the requirement exists.
  durationSeconds Int @map("duration_seconds")

  /// Starts at 1 on creation and increments on every accepted write.
  ///
  /// Two jobs. It is the compare-and-swap token — a write carries the version it read
  /// and is refused if the row has moved, which is `Admin.reviewVersion`'s mechanism
  /// exactly. And it is what `UserFeatureRestriction.policyVersion` points at, so a
  /// restriction stays explainable after the policy behind it has changed.
  ///
  /// ZERO IS NEVER STORED, and that is load-bearing on the API: because a row begins
  /// at 1, `expectedVersion: 0` unambiguously means "I expect no row to exist yet", so
  /// creation and update are the same call with the same token and there is no
  /// separate create path that could skip the swap.
  version Int @default(1)

  /// The admin who last wrote this row, as a note rather than a join.
  ///
  /// Deliberately NOT a foreign key: admins live in the `admin` schema, which this
  /// service neither models nor may constrain against, and `AdminCaptchaProvider`
  /// makes the same call for the same reason — a constraint that blocks an incident
  /// response is worse than an unverified string.
  updatedByAdminId String? @map("updated_by_admin_id") @db.Uuid

  /// Why, for whoever reads this row later. Required by the Admin DTO on any write
  /// that weakens protection, following `captchaToggleRequestSchema`'s rule.
  reason String? @db.VarChar(256)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// `@default(now())` and not `@updatedAt` — Prisma only maintains `@updatedAt` on
  /// writes Prisma performs, so a row touched in psql during an incident would carry a
  /// timestamp that quietly lies. The write path sets it explicitly instead, exactly
  /// as `CaptchaProviderDbOperation.setEnabled` does.
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  /// A PLAIN unique constraint, not a partial index in db/sql/identity.sql.
  ///
  /// The partial-index convention exists for soft-deleted rows, where a plain
  /// constraint would reserve a value forever. This table has no `deletedAt` and holds
  /// exactly one row per pair for its whole life, so there is nothing to scope around
  /// — and a constraint Prisma can express belongs in the model, visible next to the
  /// columns it governs.
  @@unique([action, context], map: "ux_security_restriction_policies_target")
  @@map("security_restriction_policies")
  @@schema("identity")
}

/// ═══ WHAT WAS IN FORCE, AND WHEN ════════════════════════════════════════════
///
/// Append-only. One row per accepted write to `SecurityRestrictionPolicy`, carrying
/// the state that write RESULTED IN.
///
/// ─── Why the resulting state and not a before/after diff ──────────────────
///
/// Because the question this table answers is "what did version N say", not "what
/// changed at version N". A restriction row points at a version and needs the
/// configuration it was created under; a diff would make every such lookup a fold over
/// the whole history. The diff is still available — it is the difference between
/// consecutive rows — and is derived rather than stored, so the two cannot disagree.
///
/// ─── This table decides nothing ───────────────────────────────────────────
///
/// It has no `active` flag, no `current` column and no partial index naming a live
/// row, and it must never grow one. `SecurityRestrictionPolicy` is the only authority
/// for what applies now; this is a log. Keeping decision and record in separate tables
/// is what makes "which policy is active" unanswerable incorrectly — there is nothing
/// here that could claim to be active.
///
/// ─── "Append-only" is a SERVICE CONTRACT, not a database guarantee ────────
///
/// Stated plainly so nobody reads the word "immutable" above as something the schema
/// enforces: no DDL here prevents an `UPDATE` or a `DELETE` against these rows. What
/// holds the property is that there is no Admin API that mutates history, and an
/// accepted policy write only ever APPENDS.
///
/// A `BEFORE UPDATE OR DELETE` trigger would make it a real constraint, and it was
/// considered and declined for V1: this repository has no trigger anywhere, and
/// introducing the mechanism for one table would add a class of thing every future
/// reader and every migration has to reason about, to defend against a writer that
/// does not exist. Revisit if a second writer ever gains access to this schema.
///
/// The uniqueness constraint below is still load-bearing against the realistic
/// accident — a retried write cannot record version N twice.
///
/// ─── Retention ───────────────────────────────────────────────────────────
///
/// Kept indefinitely for now. Sixteen pairs written a handful of times a year is not a
/// growth concern, and pruning would silently strip the explanation from any
/// restriction row still pointing at a pruned version. If it is ever pruned, the floor
/// must be the oldest `policyVersion` still referenced by a live restriction.
model SecurityRestrictionPolicyVersion {
  id String @id @db.Uuid

  /// The pair this version belongs to. Denormalised from the live row rather than
  /// joined to it, because this table has to stay readable after the live row is
  /// updated — and, in principle, after it is gone.
  action  String @db.VarChar(48)
  context String @db.VarChar(32)

  /// The value `SecurityRestrictionPolicy.version` held after this write. The newest
  /// row for a pair therefore always matches the live row.
  version Int

  // ─── the state this write resulted in ─────────────────────────────────────
  enabled         Boolean
  features        String[] @default([])
  subFeatures     String[] @default([])
  durationSeconds Int      @map("duration_seconds")

  /// Who made this write and why. Not a foreign key, for the live table's reason.
  updatedByAdminId String? @map("updated_by_admin_id") @db.Uuid
  reason           String? @db.VarChar(256)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// The lookup `UserFeatureRestriction.policyVersion` resolves through, and the
  /// constraint that makes a version number mean exactly one configuration. It also
  /// makes a double-write impossible to record twice: a retry that re-appends version
  /// N is refused by the database rather than silently producing two histories.
  @@unique([action, context, version], map: "ux_security_restriction_policy_versions_target")
  @@map("security_restriction_policy_versions")
  @@schema("identity")
}

/// ═══ ONE FEATURE WITHHELD FROM ONE ACCOUNT, FOR A WHILE ═════════════════════
///
/// Written by this service — never by an Admin — inside the same transaction as the
/// sensitive mutation that caused it.
///
/// ─── Why in that transaction ──────────────────────────────────────────────
///
/// `RetainedEmailDbOperation.changeEmail` already answers this for the one restriction
/// this codebase had before: the cooldown stamp is written in the same statement as
/// the address move, because "an address that has moved without the freeze having
/// started is precisely the instant an attacker needs. Same statement, same commit, no
/// window." A password changed without its restriction applied is that same instant,
/// and six of the eight triggers keep the caller's session alive on purpose, so this
/// row is the only thing standing between the actor and the feature.
///
/// ─── Rows overlap, and the longest one wins ───────────────────────────────
///
/// No uniqueness across rows: two triggers inside one window legitimately produce two
/// live rows for the same target. Enforcement takes `MAX(expires_at)` over the live
/// matches — never a sum, which would let repeated actions compound toward a permanent
/// lock, and never a replacement, which would let a later short restriction SHORTEN an
/// earlier long one. An attacker who could shorten a restriction by performing a
/// low-duration trigger action would have a way out of the mechanism.
///
/// ─── Expiry is read, never swept ──────────────────────────────────────────
///
/// A restriction ends when `expires_at` passes, evaluated at read time. Nothing flips a
/// flag, so there is no sweeper latency between the instant it ends and the instant the
/// user can act — and no job whose failure would leave an account restricted forever.
///
/// ─── Expired rows are kept ────────────────────────────────────────────────
///
/// They are the only record of what was withheld and why. This service has no audit
/// table, so these rows ARE the audit trail for the feature, which is why they carry
/// the observed context and the request id rather than only the decision. `Session`
/// takes the same stance for the same reason: a revoked row is kept forever and stays
/// queryable.
///
/// ─── Deletion, and the asymmetry between the two kinds ────────────────────
///
/// A DELETED account (the thirty-day recovery window: `status=DELETED`, `purgeAt` set,
/// `deletedAt` null) keeps every row here, and a reactivation inside that window finds
/// them still live. That is deliberate and it is the fail-safe direction: deleting and
/// immediately restoring an account must not be a way to shed a restriction that was
/// applied moments earlier. Nothing clears these on reactivation.
///
/// A HARD-PURGED account has no row at all — `purgeAccount` issues a real
/// `DELETE FROM users` and the `onDelete: Cascade` below takes these with it. So there
/// is no orphan state: either the account exists and its history does, or neither does.
model UserFeatureRestriction {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A `PLATFORM_FEATURES` key.
  feature String @db.VarChar(64)

  /// A sub-feature under `feature`, or NULL for the whole feature.
  ///
  /// NULL IS THE WHOLE FEATURE, and that is what makes "restrict this feature
  /// entirely" representable without a second boolean that could contradict it. Stored
  /// bare rather than qualified — unlike `SecurityRestrictionPolicy.subFeatures` —
  /// because here the parent is already in its own column on the same row, so there is
  /// nothing to disambiguate.
  subFeature String? @map("sub_feature") @db.VarChar(64)

  /// The `TRIGGER_ACTIONS` member whose success created this row.
  triggerAction String @map("trigger_action") @db.VarChar(48)

  /// ─── TWO COLUMNS, AND THE DIFFERENCE BETWEEN THEM IS THE POINT ──────────
  ///
  /// `classification` is what the evaluator CONCLUDED: `COMMON_IP_DEVICE`,
  /// `NEW_CONTEXT`, or `UNCLASSIFIED` when the request matched neither rule.
  ///
  /// `policyContext` is which configured policy was APPLIED, and can only ever be one
  /// of the two an Admin can configure — `UNCLASSIFIED` resolves to `NEW_CONTEXT`
  /// through `POLICY_FOR_CLASSIFICATION`.
  ///
  /// Collapsing them into one column would make the row claim the evaluator was
  /// confident when it was not, and would leave no way to measure how often the
  /// fail-safe path is taken — which is the number that says whether the classifier is
  /// working or whether it is quietly guessing about most of the traffic.
  classification String @db.VarChar(32)
  policyContext  String @map("policy_context") @db.VarChar(32)

  /// The `SecurityRestrictionPolicy.version` in force when this row was written.
  ///
  /// Resolves against `SecurityRestrictionPolicyVersion (action, context, version)`
  /// using `triggerAction` and `policyContext`, NOT `classification`, because the
  /// unclassified case has no policy of its own.
  ///
  /// A lookup, not a foreign key. History may in principle be pruned, and a constraint
  /// would then either block the prune or cascade into deleting restrictions; losing
  /// the explanation is the acceptable failure, losing the restriction is not.
  policyVersion Int @map("policy_version")

  startsAt DateTime @map("starts_at") @db.Timestamptz

  /// STORED, never re-derived from the policy's current duration.
  ///
  /// `OauthLink.unlinkAt` and `User.purgeAt` both make this argument: a deadline that
  /// was given must not move when the constant behind it changes. An Admin shortening
  /// a policy from 24 hours to 30 minutes must not retroactively release accounts that
  /// were already restricted for a day.
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  // ─── the context that was observed, captured at request entry ─────────────
  //
  // Recorded rather than re-derived, because by the time this row is written the
  // session sweep may already have revoked the session these came from. They are also
  // what makes a false positive diagnosable after the fact.

  /// The /24 or /48, matching `Session.ipClass` and `TrustedDevice.ipClassAtTrust`.
  ipClassAtTrigger String @map("ip_class_at_trigger")

  /// The acting session's `deviceFingerprint`. Null only for a caller that somehow
  /// reached a settings mutation without one.
  deviceFingerprintAtTrigger String? @map("device_fingerprint_at_trigger")

  /// Observed, never declared — `Session.country`'s distinction. Null until a geo
  /// provider is bound, which is also why `isNewCountry` is false for everyone today.
  countryAtTrigger String? @map("country_at_trigger") @db.Char(2)

  /// Fastify's per-request id, so a row ties back to the application log and to the
  /// `requestId` that `ProblemJsonFilter` already puts on error responses.
  requestId String? @map("request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, expiresAt])
  @@map("user_feature_restrictions")
  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────────
// chat — public rooms, messages, moderation and chat settings
//
// Owned by the chat module (src/social/chat). What Prisma cannot express lives in the chat migrations only, and the
// schema drift test (tests/social/chat.schema-drift.spec.ts) lists each such object by name:
//   - chat.room_messages is PARTITIONED by month on created_at (chat.ensure_message_partitions), so its primary key
//     is (id, created_at) and every table that links to a message links on both columns;
//   - partial indexes (pinned / skin messages, one report per user, due settings changes, pending media removals);
//   - links from chat columns to identity.users (kept out of the User model, which is not chat's);
//   - CHECK constraints and the append-only trigger on chat.moderation_actions.
// Every time column defaults to the database clock; chat code never sends a time for them.
// ─────────────────────────────────────────────────────────────────────────────

model Room {
  id          String    @id @db.Uuid
  slug        String    @unique
  name        String
  description String?
  type        RoomType  @default(GLOBAL)
  /// The room contract's config document (status, rules, content controls, moderation). See chat.contract.ts.
  config      Json      @default("{}")
  createdAt   DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  /// Set only by "delete room". A room turned OFF keeps deleted_at NULL and has config.status DISABLED.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  messages      RoomMessage[]
  accessRule    RoomAccessRule?
  bans          UserBan[]
  excludedUsers RoomExcludedUser[]
  /// Users whose last opened room this is.
  lastOpenedBy  UserChatPreference[]
  restrictions  ChatUserRestriction[]
  adPlacements  ChatAdPlacement[]
  includedUsers RoomIncludedUser[]

  @@map("rooms")
  @@schema("chat")
}

enum RoomType {
  GLOBAL
  COUNTRY
  CONTINENT
  REGION
  LANGUAGE
  PREMIUM
  VIP
  KYC
  CASINO
  SO
  STAFF

  @@schema("chat")
}

/// What an ineligible viewer of a room gets (Chat SETTINGS "If you are Not from the region / Language").
enum IneligibleMode {
  VIEW_ONLY
  HIDE
  PROMO_ONLY

  @@schema("chat")
}

/// One per room. The room type adds its own gate on top (see ChatUtility.evaluateRoomAccess).
model RoomAccessRule {
  id                 String         @id @db.Uuid
  roomId             String         @unique @map("room_id") @db.Uuid
  room               Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// A REGION room may name a region instead of listing its countries.
  regionId           String?        @map("region_id") @db.Uuid
  region             ChatRegion?    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  /// Minimum user level to write (Chat SETTINGS "Minimum Level Required to Chat").
  minLevel           Int            @default(0) @map("min_level")
  /// USD, 8 decimals stored. Casino rooms only, and only when the room's `casino.onlyUsersOnCasino` switch is on.
  minWagerUsd        Decimal?       @map("min_wager_usd") @db.Decimal(18, 8)
  requirePremium     Boolean        @default(false) @map("require_premium")
  requireVip         Boolean        @default(false) @map("require_vip")
  minKycLevel        Int            @default(0) @map("min_kyc_level")
  /// Premium plan ids from the Premium module; empty means any active plan.
  allowedPlanIds     String[]       @default([]) @map("allowed_plan_ids")
  allowedCountries   String[]       @default([]) @map("allowed_countries") @db.Char(2)
  ineligibleMode     IneligibleMode @default(VIEW_ONLY) @map("ineligible_mode")
  /// Chat SETTINGS "Visibility: ALL / Specific": empty = everyone; else PREMIUM, VIP, SO, STAFF or KYC.
  visibilityGroups   String[]       @default([]) @map("visibility_groups")
  visibilityMinLevel Int            @default(0) @map("visibility_min_level")

  @@map("room_access_rules")
  @@schema("chat")
}

model ChatRegion {
  id        String   @id @db.Uuid
  name      String   @unique
  countries String[] @default([]) @db.Char(2)
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz

  accessRules RoomAccessRule[]

  @@map("regions")
  @@schema("chat")
}

/// Users staff or an admin added to a room they would not otherwise have access to (Module 4).
model RoomIncludedUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String   @map("room_id") @db.Uuid
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdByAdmin String?  @map("created_by_admin") @db.Uuid
  createdAt      DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  removedAt DateTime? @map("removed_at") @db.Timestamptz
  removedBy String?   @map("removed_by") @db.Uuid
  @@index([userId])
  @@map("room_included_users")
  @@schema("chat")
}

/// Site owners an admin has barred from a Site-Owner room.
model RoomExcludedUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  removedAt DateTime? @map("removed_at") @db.Timestamptz
  removedBy String?   @map("removed_by") @db.Uuid
  @@map("room_excluded_users")
  @@schema("chat")
}

/// Chat-wide settings: one row holding `{ global, countries: { IN: {...} } }`. See chat.contract.ts.
model ChatSettings {
  id        Int      @id @default(1) @db.SmallInt
  document  Json     @default("{\"global\":{},\"countries\":{}}")
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz

  @@map("settings")
  @@schema("chat")
}

/// Partitioned by month on created_at; see the note at the top of this section.
model RoomMessage {
  id                 String      @db.Uuid
  roomId             String      @map("room_id") @db.Uuid
  room               Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// The author, or the fixed system author for system alerts — which is why there is no user link.
  userId             String      @map("user_id") @db.Uuid
  /// Plain text exactly as typed. Clients render it as text, never as HTML.
  content            String
  type               MessageType @default(TEXT)
  skinId             String?     @map("cosmetic_id") @db.Uuid
  skin               ChatSkin?   @relation(fields: [skinId], references: [id], onDelete: Restrict)
  metadata           Json        @default("{}")
  createdAt          DateTime    @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  retractedAt        DateTime?   @map("retracted_at") @db.Timestamptz
  /// A platform user (the author or chat staff).
  retractedBy        String?     @map("retracted_by") @db.Uuid
  /// An admin-backend admin id.
  retractedByAdminId String?     @map("retracted_by_admin_id") @db.Uuid
  pinnedAt           DateTime?   @map("pinned_at") @db.Timestamptz
  pinnedBy           String?     @map("pinned_by") @db.Uuid

  reports   ChatMessageReport[]
  mentions  MessageMention[]
  clientIds ClientMessageId[]

  @@id([id, createdAt])
  @@index([roomId, createdAt(sort: Desc), id(sort: Desc)], map: "room_messages_room_id_created_at_id_idx")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "room_messages_user_id_created_at_id_idx")
  @@map("room_messages")
  @@schema("chat")
}

enum MessageType {
  TEXT
  MEDIA
  SYSTEM_ALERT
  ADMIN_ALERT
  /// An ad posted into the room (Module 5).
  AD
  /// The chat notice of a completed gift (Module 5).
  GIFT

  @@schema("chat")
}

model MessageMention {
  mentionedUserId String      @map("mentioned_user_id") @db.Uuid
  createdAt       DateTime    @map("created_at") @db.Timestamptz
  messageId       String      @map("message_id") @db.Uuid
  roomId          String      @map("room_id") @db.Uuid
  message         RoomMessage @relation(fields: [messageId, createdAt], references: [id, createdAt], onDelete: Restrict, map: "message_mentions_message_fkey")

  @@id([mentionedUserId, createdAt, messageId])
  @@map("message_mentions")
  @@schema("chat")
}

model ClientMessageId {
  userId           String      @map("user_id") @db.Uuid
  clientMessageId  String      @map("client_message_id") @db.Uuid
  messageId        String      @map("message_id") @db.Uuid
  messageCreatedAt DateTime    @map("message_created_at") @db.Timestamptz
  message          RoomMessage @relation(fields: [messageId, messageCreatedAt], references: [id, createdAt], onDelete: Restrict, map: "client_message_ids_message_fkey")
  createdAt        DateTime    @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@id([userId, clientMessageId])
  @@index([createdAt])
  @@map("client_message_ids")
  @@schema("chat")
}

/// A chat skin (database table name kept: message_cosmetics). Never hard-deleted: deactivated instead.
model ChatSkin {
  id          String   @id @db.Uuid
  name        String
  styleConfig Json     @map("style_config")
  /// USD, 8 decimals stored, shown cut to 2.
  cost        Decimal  @default(0.0) @db.Decimal(18, 8)
  isPremium   Boolean  @default(false) @map("is_premium")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  messages        RoomMessage[]
  userPreferences UserChatPreference[]

  @@map("message_cosmetics")
  @@schema("chat")
}

model UserChatPreference {
  id               String    @id @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  /// The profile-level "hide identity" setting (Chat MAIN). Applied to each message when it is sent.
  hideIdentity     Boolean   @default(false) @map("hide_identity")
  activeSkinId     String?   @map("active_cosmetic_id") @db.Uuid
  activeSkin       ChatSkin? @relation(fields: [activeSkinId], references: [id], onDelete: SetNull, map: "user_chat_preferences_active_cosmetic_id_fkey")
  /// "Last online": database time of the user's last disconnect (or connect).
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  /// The room the user last opened, kept on the server so any device reopens it. Cleared if the room is deleted.
  lastOpenedRoomId String?   @map("last_opened_room_id") @db.Uuid
  lastOpenedRoom   Room?     @relation(fields: [lastOpenedRoomId], references: [id], onDelete: SetNull, map: "user_chat_preferences_last_opened_room_id_fkey")
  /// Privacy and notifications (Modules 8–9). NULL = the admin default in the chat settings `privacy` section.
  lastSeenVisibility     String?   @map("last_seen_visibility")
  commonGroupsVisibility String?   @map("common_groups_visibility")
  notifyPrimary          Boolean?  @map("notify_primary")
  notifyGeneral          Boolean?  @map("notify_general")
  notifyGroups           Boolean?  @map("notify_groups")
  /// AUTO_NIGHT, OFF or CUSTOM (quietStart–quietEnd in timeZone).
  quietMode              String?   @map("quiet_mode")
  quietStart             String?   @map("quiet_start")
  quietEnd               String?   @map("quiet_end")
  timeZone               String?   @map("time_zone")
  /// One switch for "typing..." and read receipts, both directions (V2-43).
  typingReceiptsEnabled  Boolean   @default(true) @map("typing_receipts_enabled")

  @@map("user_chat_preferences")
  @@schema("chat")
}

/// Chat staff. ADMIN and MODERATOR moderate; SUPPORT only enters the Staff room until Module 4.
model ChatStaffRole {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       StaffRole
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(dbgenerated("now()")) @map("assigned_at") @db.Timestamptz

  removedAt  DateTime? @map("removed_at") @db.Timestamptz
  removedBy  String?   @map("removed_by") @db.Uuid

  @@map("staff_roles")
  @@schema("chat")
}

enum StaffRole {
  ADMIN
  MODERATOR
  SUPPORT

  @@schema("chat")
}

model UserBan {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roomId      String?   @map("room_id") @db.Uuid
  room        Room?     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// Chat staff (a platform user) who banned; null for admins and auto-moderation.
  moderatorId String?   @map("moderator_id") @db.Uuid
  /// Admin-backend admin who banned.
  adminId     String?   @map("admin_id") @db.Uuid
  /// What staff and admins write (required): never shown to the user (V2-104). Automatic bans carry the rule's name.
  internalReason String  @map("internal_reason")
  /// The optional reason the user sees in the notice and in their own list.
  userReason  String?   @map("user_reason")
  bannedAt    DateTime  @default(dbgenerated("now()")) @map("banned_at") @db.Timestamptz
  /// Null means permanent.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  isActive    Boolean   @default(true) @map("is_active")
  liftedBy    String?   @map("lifted_by") @db.Uuid
  liftedAt    DateTime? @map("lifted_at") @db.Timestamptz
  /// The chat role the issuer had when the ban was given (rank of the ban); null for admins and auto-moderation.
  moderatorRole String?  @map("moderator_role")

  @@index([userId, roomId, isActive, expiresAt])
  @@map("user_bans")
  @@schema("chat")
}

model ChatMessageReport {
  id               String       @id @db.Uuid
  /// Null for a report about a user rather than a message.
  messageId        String?      @map("message_id") @db.Uuid
  messageCreatedAt DateTime?    @map("message_created_at") @db.Timestamptz
  message          RoomMessage? @relation(fields: [messageId, messageCreatedAt], references: [id, createdAt], onDelete: Restrict, map: "chat_message_reports_message_fkey")
  reporterId       String       @map("reporter_id") @db.Uuid
  reportedUserId   String       @map("reported_user_id") @db.Uuid
  reason           String
  reasonRef        ReportReason @relation(fields: [reason], references: [code], onDelete: Restrict)
  details          String?
  status           ReportStatus @default(PENDING)
  /// DISMISS, WARN, BAN or RETRACT_MESSAGE once resolved.
  action           String?
  resolvedBy       String?      @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?    @map("resolved_at") @db.Timestamptz
  createdAt        DateTime     @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  /// A report about a direct or group message (Module 8).
  dmMessageId      String?      @map("dm_message_id") @db.Uuid
  /// With dmMessageId: the message's partition key. No foreign key: old months are detached into chat_archive.
  dmMessageCreatedAt DateTime?  @map("dm_message_created_at") @db.Timestamptz

  @@index([messageId])
  @@index([reporterId, createdAt])
  @@index([reportedUserId])
  @@index([status])
  @@unique([dmMessageId, reporterId], map: "chat_message_reports_dm_message_reporter_key")
  @@map("chat_message_reports")
  @@schema("chat")
}

/// The reason list users pick from; the admin edits it.
model ReportReason {
  code      String  @id
  label     String
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  /// 'MESSAGE' (Chat Messages or Requests) or 'USER' (User Profile): each report type has its own list (FR-250).
  reportType String @default("MESSAGE") @map("report_type")

  reports ChatMessageReport[]

  @@map("report_reasons")
  @@schema("chat")
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED

  @@schema("chat")
}

model ChatWarning {
  id              String   @id @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  roomId          String?  @map("room_id") @db.Uuid
  internalReason  String   @map("internal_reason")
  userReason      String?  @map("user_reason")
  /// Chat staff (a platform user); null for admins and auto-moderation.
  issuedBy        String?  @map("issued_by") @db.Uuid
  issuedByAdminId String?  @map("issued_by_admin_id") @db.Uuid
  createdAt       DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("chat_warnings")
  @@schema("chat")
}

/// Append-only (a trigger refuses UPDATE and DELETE): every admin, staff and automatic moderation action.
model ModerationAction {
  id                     String    @id @db.Uuid
  /// ADMIN, STAFF or SYSTEM.
  actorType              String    @map("actor_type")
  actorId                String?   @map("actor_id") @db.Uuid
  action                 String
  targetUserId           String?   @map("target_user_id") @db.Uuid
  targetRoomId           String?   @map("target_room_id") @db.Uuid
  targetMessageId        String?   @map("target_message_id") @db.Uuid
  targetMessageCreatedAt DateTime? @map("target_message_created_at") @db.Timestamptz
  oldValue               Json?     @map("old_value")
  newValue               Json?     @map("new_value")
  note                   String?
  createdAt              DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("moderation_actions")
  @@schema("chat")
}

/// The chat-wide auto-moderation ladder position of a user (offences count across rooms); a lapsed row counts from 1 again.
model ModerationOffence {
  userId    String   @id @map("user_id") @db.Uuid
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("moderation_offences")
  @@schema("chat")
}

/// Every chat upload. uploader_id has no user link: the record survives account erasure (legal hold).
model MediaUpload {
  id            String    @id @db.Uuid
  uploaderId    String    @map("uploader_id") @db.Uuid
  createdAt     DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  mimeType      String    @map("mime_type")
  sizeBytes     Int       @map("size_bytes")
  sha256        String
  storageKey    String    @map("storage_key")
  flaggedAt     DateTime? @map("flagged_at") @db.Timestamptz
  flaggedBy     String?   @map("flagged_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleteNote    String?   @map("delete_note")
  fileRemovedAt DateTime? @map("file_removed_at") @db.Timestamptz

  @@index([uploaderId, createdAt])
  @@map("media_uploads")
  @@schema("chat")
}

model RuntimeStats {
  id                 Int      @id @default(1) @db.SmallInt
  onlineUsers        Int      @default(0) @map("online_users")
  sockets            Int      @default(0)
  messagesLastMinute Int      @default(0) @map("messages_last_minute")
  updatedAt          DateTime @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz

  @@map("runtime_stats")
  @@schema("chat")
}

model FrequentHitter {
  userId       String    @id @map("user_id") @db.Uuid
  lastIp       String?   @map("last_ip")
  hits         Int       @default(0)
  lastHitAt    DateTime  @default(dbgenerated("now()")) @map("last_hit_at") @db.Timestamptz
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz

  @@index([lastHitAt(sort: Desc)])
  @@map("frequent_hitters")
  @@schema("chat")
}

model SettingsChange {
  id          String    @id @db.Uuid
  /// SETTINGS (chat-wide) or ROOM.
  target      String
  roomId      String?   @map("room_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  patch       Json
  before      Json?
  effectiveAt DateTime  @map("effective_at") @db.Timestamptz
  /// SCHEDULED, APPLIED or CANCELLED.
  status      String
  createdAt   DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("settings_changes")
  @@schema("chat")
}

/// Test-only stand-in facts. Read only when the stand-ins are switched on outside production (chat.test-providers.ts).
model TestEntitlement {
  userId         String   @id @map("user_id") @db.Uuid
  premiumPlanIds String[] @default([]) @map("premium_plan_ids")
  kycLevel       Int?     @map("kyc_level")
  isSiteOwner    Boolean  @default(false) @map("is_site_owner")
  isVip          Boolean  @default(false) @map("is_vip")
  level          Int?
  onCasino       Boolean  @default(false) @map("on_casino")
  wagerUsd       Decimal  @default(0) @map("wager_usd") @db.Decimal(28, 8)
  /// Ids this user follows (stand-in for the follow module, Modules 8–9).
  follows        String[] @default([]) @db.Uuid
  updatedAt      DateTime @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz

  @@map("test_entitlements")
  @@schema("chat")
}

// ─────────────────────────────────────────────────────────────────────────────
// chat — Module 4: role permissions (restrictions on users and groups, staff requests)
// ─────────────────────────────────────────────────────────────────────────────

/// A restriction on one user or a group of users (Premium, KYC, level), chat-wide or in one room. Lifted, never deleted.
model ChatUserRestriction {
  id             String    @id @db.Uuid
  /// USER, PREMIUM, KYC or LEVEL.
  targetType     String    @map("target_type")
  /// USER: a user id. LEVEL: the minimum level. PREMIUM / KYC: ignored.
  targetValue    String    @map("target_value")
  /// One of the contract's RESTRICTION_KINDS.
  kind           String
  /// RESTRICT_COMMANDS only; empty = every command.
  commands       String[]  @default([])
  roomId         String?   @map("room_id") @db.Uuid
  room           Room?     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  internalReason String @map("internal_reason")
  userReason     String? @map("user_reason")
  /// Chat staff (a platform user) who restricted; null for admins.
  createdBy      String?   @map("created_by") @db.Uuid
  createdByAdmin String?   @map("created_by_admin") @db.Uuid
  createdByRole  String?   @map("created_by_role")
  createdAt      DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  /// Null = until lifted.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  liftedAt       DateTime? @map("lifted_at") @db.Timestamptz
  liftedBy       String?   @map("lifted_by") @db.Uuid
  liftedByAdmin  String?   @map("lifted_by_admin") @db.Uuid

  @@index([targetType, targetValue])
  @@index([createdAt(sort: Desc)])
  @@map("user_restrictions")
  @@schema("chat")
}

/// A permission used in REPORT mode: a staff member asks a higher role (or an admin) to act.
model ChatStaffRequest {
  id              String    @id @db.Uuid
  requesterId     String    @map("requester_id") @db.Uuid
  requesterRole   String    @map("requester_role")
  /// One of STAFF_PERMISSIONS.
  permission      String
  targetUserId    String?   @map("target_user_id") @db.Uuid
  targetRoomId    String?   @map("target_room_id") @db.Uuid
  /// What the action would do (duration, restriction kind, rules text…).
  payload         Json      @default("{}")
  /// The requester's text box.
  note            String
  /// PENDING, APPROVED or REJECTED.
  status          String    @default("PENDING")
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  resolvedByAdmin String?   @map("resolved_by_admin") @db.Uuid
  resolutionNote  String?   @map("resolution_note")
  createdAt       DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz

  @@index([status, createdAt(sort: Desc)])
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("staff_requests")
  @@schema("chat")
}

// ─────────────────────────────────────────────────────────────────────────────
// chat — Module 5: mute, block, commands, ads and gifts
// ─────────────────────────────────────────────────────────────────────────────

/// /mute: the user no longer sees the target's public messages; DMs still work (Chat SETTINGS "/mute").
model UserMute {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  removedAt DateTime? @map("removed_at") @db.Timestamptz
  removedBy String?   @map("removed_by") @db.Uuid
  @@index([targetId])
  @@map("user_mutes")
  @@schema("chat")
}

/// /block: the user no longer sees the target's public messages, and the two cannot DM or gift each other.
model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  removedAt DateTime? @map("removed_at") @db.Timestamptz
  removedBy String?   @map("removed_by") @db.Uuid
  @@index([targetId])
  @@map("user_blocks")
  @@schema("chat")
}

/// Append-only log of every chat command run or refused; ids and amounts only, never message text.
model ChatCommandLog {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roomId    String?  @map("room_id") @db.Uuid
  command   String
  args      Json     @default("{}")
  /// EXECUTED or REFUSED.
  result    String
  /// The refusal reason.
  reason    String?
  createdAt DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("chat_commands")
  @@schema("chat")
}

/// A chat ad (/ad or the admin panel). Never deleted: a cancelled or refunded ad keeps its row.
model ChatAd {
  id              String    @id @db.Uuid
  /// The advertiser (a platform user), or null for an admin's ad.
  creatorId       String?   @map("creator_id") @db.Uuid
  creatorAdminId  String?   @map("creator_admin_id") @db.Uuid
  content         String
  roomIds         String[]  @map("room_ids") @db.Uuid
  allRooms        Boolean   @default(false) @map("all_rooms")
  /// Pinned ads only: minutes on top of each room.
  pinMinutes      Int?      @map("pin_minutes")
  /// Extra posts after the first; 0 = posted once.
  repeatCount     Int       @default(0) @map("repeat_count")
  repeatGapMin    Int?      @map("repeat_gap_min")
  postedCount     Int       @default(0) @map("posted_count")
  /// Database time of the next repeat; null when nothing is left to post.
  nextPostAt      DateTime? @map("next_post_at") @db.Timestamptz
  /// "GEO Targeting: Hide ad from specific country users".
  hiddenCountries String[]  @default([]) @map("hidden_countries")
  badgeId         String?   @map("badge_id")
  /// USD, 8 decimals.
  priceUsd        Decimal   @default(0) @map("price_usd") @db.Decimal(18, 8)
  breakdown       Json      @default("[]")
  chargeReference String?   @map("charge_reference")
  /// ACTIVE, PAUSED, COMPLETED, CANCELLED or REFUNDED.
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelNote      String?   @map("cancel_note")
  /// USD to give back for unused posts and pinned minutes; refundedAt is set once the payment module returned it.
  refundUsd       Decimal?  @map("refund_usd") @db.Decimal(18, 8)
  refundedAt      DateTime? @map("refunded_at") @db.Timestamptz
  /// "Ad Skins": the skin chosen from the ads settings.
  skinId           String?   @map("skin_id")
  /// EXP and universal currency the advertiser earned ("Universal Currency and EXP").
  rewards          Json      @default("{}")
  /// An admin revert asked for the rewards to be taken back; rewardsRevokedAt is set once done.
  revertRewards    Boolean   @default(false) @map("revert_rewards")
  rewardsRevokedAt DateTime? @map("rewards_revoked_at") @db.Timestamptz
  /// The advertiser's key for this purchase (unique per advertiser) and a fingerprint of what it asked for.
  idempotencyKey     String?   @map("idempotency_key")
  requestFingerprint String?   @map("request_fingerprint")
  /// Set while a worker holds the row (repeat post, refund, payment check); an old claim is taken over.
  claimedAt          DateTime? @map("claimed_at") @db.Timestamptz
  failureReason      String?   @map("failure_reason")
  /// The coin the advertiser asked the refund in (one of ads.refundCurrencies), or null for the default.
  refundCurrency     String?   @map("refund_currency")
  /// USER or INTERNAL ('Orebit internal ad', FR-261).
  kind               String    @default("USER")
  /// "18+ Advertisements" (FR-260).
  is18Plus           Boolean   @default(false) @map("is_18_plus")
  /// Premium or coupon plan id applied (FR-234, V2-76).
  planId             String?   @map("plan_id")
  /// USD discount granted by loyalty/coupons (FR-234).
  discountUsd        Decimal?  @map("discount_usd") @db.Decimal(18, 8)

  placements ChatAdPlacement[]

  @@index([creatorId, createdAt(sort: Desc)])
  @@index([status, nextPostAt])
  @@index([createdAt(sort: Desc)])
  @@map("chat_ads")
  @@schema("chat")
}

/// One pinned slot of one ad in one room: QUEUED → ACTIVE → DONE (or CANCELLED).
model ChatAdPlacement {
  id        String    @id @db.Uuid
  adId      String    @map("ad_id") @db.Uuid
  ad        ChatAd    @relation(fields: [adId], references: [id], onDelete: Restrict)
  roomId    String    @map("room_id") @db.Uuid
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  minutes   Int
  status    String    @default("QUEUED")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz
  endsAt    DateTime? @map("ends_at") @db.Timestamptz
  createdAt DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@index([roomId, status, createdAt])
  @@index([adId])
  @@map("chat_ad_placements")
  @@schema("chat")
}

/// A warning for a group (Premium, KYC or a level): one rule that a user's warnings list evaluates, never one row per user.
model GroupWarning {
  id           String   @id @db.Uuid
  targetType   String   @map("target_type")
  targetValue  String   @map("target_value")
  roomId       String?  @map("room_id") @db.Uuid
  internalReason String @map("internal_reason")
  userReason   String?  @map("user_reason")
  issuedBy     String   @map("issued_by") @db.Uuid
  issuedByRole String   @map("issued_by_role")
  createdAt    DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("group_warnings")
  @@schema("chat")
}

/// /send, /gift and the DM gift button. Chat starts and records the gift; the transfer module moves the money.
model GiftTransfer {
  id                String    @id @db.Uuid
  senderId          String    @map("sender_id") @db.Uuid
  recipientId       String    @map("recipient_id") @db.Uuid
  currency          String
  amount            Decimal   @db.Decimal(36, 18)
  usdValue          Decimal?  @map("usd_value") @db.Decimal(18, 8)
  feeAmount         Decimal?  @map("fee_amount") @db.Decimal(36, 18)
  roomId            String?   @map("room_id") @db.Uuid
  conversationId    String?   @map("conversation_id") @db.Uuid
  /// PAYMENT_PIN or TWO_FA.
  verification      String
  /// PENDING_VERIFICATION, PROCESSING, COMPLETED, FAILED, CANCELLED; REVERT_PENDING, REVERTED or REVERT_FAILED.
  status            String    @default("PENDING_VERIFICATION")
  transferReference String?   @map("transfer_reference")
  failureReason     String?   @map("failure_reason")
  createdAt         DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  /// "Revert ALL Transfers for a Specific Time Frame … Refund Fees: YES / NO".
  revertRefundFees  Boolean   @default(false) @map("revert_refund_fees")
  revertRequestedBy String?   @map("revert_requested_by") @db.Uuid
  revertRequestedAt DateTime? @map("revert_requested_at") @db.Timestamptz
  revertedAt        DateTime? @map("reverted_at") @db.Timestamptz
  /// EXP and universal currency the sender earned.
  rewards           Json      @default("{}")
  rewardsRevokedAt  DateTime? @map("rewards_revoked_at") @db.Timestamptz
  /// When the transfer call started (PROCESSING), and the claim of a worker reconciling or reverting it.
  processingAt      DateTime? @map("processing_at") @db.Timestamptz
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz
  /// ZERO or NEGATIVE: shortfall choice when recipient spent funds (FR-264).
  revertShortfall   String?   @map("revert_shortfall")

  @@index([senderId, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([status])
  @@map("gift_transfers")
  @@schema("chat")
}

/// Chat SETTINGS "ADS — When Turning to Maintain / Off Choose": the ads status the chat server last acted on (one row).
model ChatAdsState {
  id            Int      @id @default(1) @db.SmallInt
  /// ACTIVE, MAINTENANCE or DISABLED.
  appliedStatus String   @default("ACTIVE") @map("applied_status")
  updatedAt     DateTime @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz

  @@map("ads_state")
  @@schema("chat")
}

/// "Revert ALL Transfers / Advertisements … [group of users]": queued by the admin, carried out by the chat server.
model ChatMoneyRevertJob {
  id         String    @id @db.Uuid
  /// GIFTS or ADS.
  kind       String
  /// The admin's revert filter with its group (Premium, KYC or Level).
  filter     Json
  /// PENDING, RUNNING, DONE or FAILED.
  status     String    @default("PENDING")
  result     Json?
  error      String?
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  claimedAt  DateTime? @map("claimed_at") @db.Timestamptz
  /// Where a long job stopped (a keyset after the last row done), so the next pass carries on.
  progress   Json?

  @@map("money_revert_jobs")
  @@schema("chat")
}

// ─────────────────────────────────────────────────────────────────────────────
// chat — Modules 8–9: direct messages and groups
// ─────────────────────────────────────────────────────────────────────────────

/// A direct (two people) or group conversation.
model DmConversation {
  id            String    @id @db.Uuid
  /// DIRECT or GROUP.
  kind          String
  /// DIRECT only: the two user ids in order, so a pair has one conversation.
  directKey     String?   @unique @map("direct_key")
  /// DIRECT with a site owner only: the merchant's app the chat was opened from ("sorted separately by apps").
  merchantAppId String?   @map("merchant_app_id")
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  /// DIRECT only: whether the other person followed the starter when the chat began (new-DM limits are counted per kind).
  startedWithFollower Boolean? @map("started_with_follower")

  members  DmMember[]
  messages DmMessage[]
  group    DmGroup?

  @@index([createdBy, createdAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
  @@map("dm_conversations")
  @@schema("chat")
}

/// One member's view of a conversation.
model DmMember {
  conversationId    String         @map("conversation_id") @db.Uuid
  conversation      DmConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  userId            String         @map("user_id") @db.Uuid
  /// OWNER, ADMIN, SUB_ADMIN or MEMBER (groups); MEMBER in a direct conversation.
  role              String         @default("MEMBER")
  /// ACTIVE, REQUEST (a message request), DECLINED, LEFT, REMOVED or BANNED.
  state             String         @default("ACTIVE")
  /// PRIMARY, GENERAL, GROUPS or MERCHANT (a site owner's separate folder for merchant chats).
  folder            String
  /// The user moved it by hand; the automatic folder rules no longer move it.
  folderChosen      Boolean        @default(false) @map("folder_chosen")
  pinnedAt          DateTime?      @map("pinned_at") @db.Timestamptz
  /// Direct conversations with a friend only: this member's nickname for the other.
  nickname          String?
  /// DEFAULT (folder setting), ON or OFF.
  notifications     String         @default("DEFAULT")
  lastReadMessageId String?        @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime?      @map("last_read_at") @db.Timestamptz
  /// Group timeout: may not text until then.
  timeoutUntil      DateTime?      @map("timeout_until") @db.Timestamptz
  joinedAt          DateTime       @default(dbgenerated("now()")) @map("joined_at") @db.Timestamptz
  updatedAt         DateTime       @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz

  @@id([conversationId, userId])
  @@index([userId, state, folder])
  @@map("dm_members")
  @@schema("chat")
}

/// A support ticket (Chat MAIN "Support Chat"): PENDING until support answers, OPEN while it is worked, CLOSED by a button.
model SupportTicket {
  id            String           @id @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  subject       String
  status        String           @default("PENDING")
  closedByUser  String?          @map("closed_by_user") @db.Uuid
  closedByAdmin String?          @map("closed_by_admin") @db.Uuid
  closedAt      DateTime?        @map("closed_at") @db.Timestamptz
  lastMessageAt DateTime         @default(dbgenerated("now()")) @map("last_message_at") @db.Timestamptz
  createdAt     DateTime         @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz
  messages      SupportMessage[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([status, lastMessageAt(sort: Desc)])
  @@map("support_tickets")
  @@schema("chat")
}

/// One message of a support ticket, from the user or from an admin (exactly one of the two sender ids is set).
model SupportMessage {
  id            String        @id @db.Uuid
  ticketId      String        @map("ticket_id") @db.Uuid
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  senderUserId  String?       @map("sender_user_id") @db.Uuid
  senderAdminId String?       @map("sender_admin_id") @db.Uuid
  content       String
  createdAt     DateTime      @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@index([ticketId, createdAt, id])
  @@map("support_messages")
  @@schema("chat")
}

/// A direct or group message. Never deleted: retracted (admins still see it) or hidden by a group admin.
/// Monthly partitions (dm_messages_YYYY_MM, V2-56); months older than 12 are detached into chat_archive (V2-143).
model DmMessage {
  id              String         @db.Uuid
  conversationId  String         @map("conversation_id") @db.Uuid
  conversation    DmConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderId        String         @map("sender_id") @db.Uuid
  content         String
  /// TEXT, MEDIA, GIFT or SYSTEM.
  type            String         @default("TEXT")
  metadata        Json           @default("{}")
  clientMessageId String?        @map("client_message_id") @db.Uuid
  createdAt       DateTime       @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  retractedAt     DateTime?      @map("retracted_at") @db.Timestamptz
  retractedBy     String?        @map("retracted_by") @db.Uuid
  hiddenAt        DateTime?      @map("hidden_at") @db.Timestamptz
  hiddenBy        String?        @map("hidden_by") @db.Uuid
  pinnedAt        DateTime?      @map("pinned_at") @db.Timestamptz
  pinnedBy        String?        @map("pinned_by") @db.Uuid

  @@id([id, createdAt])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("dm_messages")
  @@schema("chat")
}

/// The group of a GROUP conversation.
model DmGroup {
  conversationId String         @id @map("conversation_id") @db.Uuid
  conversation   DmConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  logoUrl        String?        @map("logo_url")
  /// PUBLIC (anyone may join) or PRIVATE (invite only).
  visibility     String
  ownerId        String         @map("owner_id") @db.Uuid
  /// Counts against the creator's limit whatever the type becomes.
  creatorId      String         @map("creator_id") @db.Uuid
  createdPublic  Boolean        @map("created_public")
  membersCanText Boolean        @default(true) @map("members_can_text")
  /// A channel: only admins post; public or private.
  isChannel      Boolean        @default(false) @map("is_channel")
  /// The lowest role allowed each delegable action, e.g. { "RENAME": "ADMIN" }.
  permissions    Json           @default("{}")
  /// The permissions the owner lets group admins change (V2-49).
  adminManageable Json          @default("[]") @map("admin_manageable")
  /// Set when the last member left; the group and its messages are kept.
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz
  /// Active members, kept by a trigger on dm_members.
  memberCount    Int            @default(0) @map("member_count")
  createdAt      DateTime       @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(dbgenerated("now()")) @map("updated_at") @db.Timestamptz

  invites   DmGroupInvite[]
  bans      DmGroupBan[]
  transfers DmOwnershipTransfer[]

  @@index([visibility, name])
  @@index([creatorId])
  @@map("dm_groups")
  @@schema("chat")
}

model DmGroupInvite {
  id             String    @id @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  group          DmGroup   @relation(fields: [conversationId], references: [conversationId], onDelete: Restrict)
  inviterId      String    @map("inviter_id") @db.Uuid
  inviteeId      String    @map("invitee_id") @db.Uuid
  /// PENDING, ACCEPTED, DECLINED or REVOKED.
  status         String    @default("PENDING")
  createdAt      DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  respondedAt    DateTime? @map("responded_at") @db.Timestamptz
  /// An invite lives for an admin-set time; null for older invites.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz

  @@index([inviteeId, status])
  @@index([conversationId])
  @@index([inviterId, createdAt(sort: Desc)])
  @@map("dm_group_invites")
  @@schema("chat")
}

model DmGroupBan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  group          DmGroup  @relation(fields: [conversationId], references: [conversationId], onDelete: Restrict)
  userId         String   @map("user_id") @db.Uuid
  bannedBy       String   @map("banned_by") @db.Uuid
  /// Rank of who banned: only someone above it can lift the ban.
  bannedByRole   String   @default("OWNER") @map("banned_by_role")
  reason         String?
  createdAt      DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  removedAt DateTime? @map("removed_at") @db.Timestamptz
  removedBy String?   @map("removed_by") @db.Uuid
  @@map("dm_group_bans")
  @@schema("chat")
}

/// An ownership transfer waiting for (or done after) the owner's 2FA proof.
model DmOwnershipTransfer {
  id             String    @id @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  group          DmGroup   @relation(fields: [conversationId], references: [conversationId], onDelete: Restrict)
  fromUserId     String    @map("from_user_id") @db.Uuid
  toUserId       String    @map("to_user_id") @db.Uuid
  /// PENDING, COMPLETED or CANCELLED.
  status         String    @default("PENDING")
  createdAt      DateTime  @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("dm_ownership_transfers")
  @@schema("chat")
}

/// One message per client id (retry de-duplication): the primary key decides a race. Old rows are pruned.
model DmMessageDedupe {
  conversationId  String   @map("conversation_id") @db.Uuid
  senderId        String   @map("sender_id") @db.Uuid
  clientMessageId String   @map("client_message_id") @db.Uuid
  messageId       String   @map("message_id") @db.Uuid
  createdAt       DateTime @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz

  @@id([conversationId, senderId, clientMessageId])
  @@index([createdAt])
  @@map("dm_message_dedupe")
  @@schema("chat")
}

/// A single row: where the live DM messages start (older months are in chat_archive).
model ChatArchiveState {
  id                       Boolean   @id @default(true)
  dmMessagesArchivedBefore DateTime? @map("dm_messages_archived_before") @db.Timestamptz

  @@map("archive_state")
  @@schema("chat")
}

/// Limit hits per user, reason and hour (FR-253): what the admin reads before unblocking a frequent hitter.
model LimitHitHourly {
  userId String   @map("user_id") @db.Uuid
  hour   DateTime @db.Timestamptz
  reason String
  hits   Int

  @@id([userId, hour, reason])
  @@index([hour])
  @@map("limit_hits_hourly")
  @@schema("chat")
}
