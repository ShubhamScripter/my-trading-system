{
  "name": "orebit-admin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Admin backend service for Orebit - NestJS, Fastify, Prisma, Redis, Vitest",
  "homepage": "https://github.com/OREBiT-Main/Orebit-admin-backend#readme",
  "bugs": {
    "url": "https://github.com/OREBiT-Main/Orebit-admin-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OREBiT-Main/Orebit-admin-backend.git"
  },
  "license": "ISC",
  "author": "Orebit",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "node --watch --env-file=.env -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "check": "npm run typecheck && npm run lint",
    "audit": "node scripts/audit.mjs",
    "audit:all": "node scripts/audit.mjs --all",
    "format": "prettier --write \"src/**/*.ts\" \"auth/**/*.ts\" \"db/**/*.ts\" \"redis/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:chat": "vitest run --config vitest.chat.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate --schema=db/schema.prisma",
    "prisma:studio": "prisma studio --schema=db/schema.prisma",
    "db:migrate": "tsx --env-file=.env db/migrate.ts",
    "db:verify": "tsx --env-file=.env db/migrate.ts --verify",
    "db:seed": "tsx --env-file=.env db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.4.0",
    "@simplewebauthn/server": "^13.1.1",
    "argon2": "^0.41.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^8.57.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.5.1",
    "prisma": "^6.4.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "orebit",
    "admin",
    "backend",
    "typescript",
    "nestjs",
    "fastify",
    "prisma",
    "redis"
  ],
  "allowScripts": {
    "argon2@0.41.1": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@swc/core@1.16.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
