    {
      "name": "08. History & Live Audit",
      "item": [
        {
          "name": "Get Room Chat History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminBaseUrl}}/social/chat/history?roomId={{roomId}}&limit=50&offset=0",
              "host": [
                "{{adminBaseUrl}}"
              ],
              "path": [
                "social",
                "chat",
                "history"
              ],
              "query": [
                {
                  "key": "roomId",
                  "value": "{{roomId}}"
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Paginates through chat messages in a room for auditing, inspection, and moderation."
          }
        }
      ]
    },
    {
      "name": "09. Moderation Studio Controls (Module 4)",
      "item": [
        {
          "name": "Get Moderation Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{adminBaseUrl}}/social/chat/moderation-settings?roomId={{roomId}}",
              "host": [
                "{{adminBaseUrl}}"
              ],
              "path": [
                "social",
                "chat",
                "moderation-settings"
              ],
              "query": [
                {
                  "key": "roomId",
                  "value": "{{roomId}}"
                }
              ]
            },
            "description": "Returns full auto-moderation settings: spam protection, auto-ban ladder, blocklist keywords, command permissions, 35 staff roles, user/group restrictions, and bot persona config."
          }
        },
        {
          "name": "Save Moderation Settings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{roomId}}\",\n  \"spamProtection\": {\n    \"enabled\": true,\n    \"repeatCount\": 3,\n    \"windowSeconds\": 10\n  },\n  \"autoBanSequence\": [\n    {\n      \"tier\": 1,\n      \"action\": \"WARNING\",\n      \"resetWindowHours\": 24\n    },\n    {\n      \"tier\": 2,\n      \"action\": \"BAN\",\n      \"durationSeconds\": 3600,\n      \"resetWindowHours\": 48\n    },\n    {\n      \"tier\": 3,\n      \"action\": \"BAN\",\n      \"durationSeconds\": 86400,\n      \"resetWindowHours\": 168\n    }\n  ],\n  \"linkPolicy\": \"OREBIT_ONLY\",\n  \"bannedWords\": [\n    \"scam\",\n    \"free money\",\n    \"t.me/\"\n  ],\n  \"globalDisabledCommands\": [\n    \"/ad\"\n  ],\n  \"allCommandsDisabled\": false,\n  \"botConfig\": {\n    \"botName\": \"OREBiT Assistant\",\n    \"botUserId\": \"system-bot-01\",\n    \"botAvatar\": \"BOT\",\n    \"isActive\": true,\n    \"welcomeTemplate\": \"Welcome to {room}, @{user}! Please abide by our chat community guidelines.\"\n  }\n}"
            },
            "url": {
              "raw": "{{adminBaseUrl}}/social/chat/moderation-settings",
              "host": [
                "{{adminBaseUrl}}"
              ],
              "path": [
                "social",
                "chat",
                "moderation-settings"
              ]
            },
            "description": "Saves room auto-moderation configurations."
          }
