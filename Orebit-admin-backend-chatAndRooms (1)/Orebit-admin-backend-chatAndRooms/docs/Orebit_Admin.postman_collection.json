        {
          "name": "Issue User Ban",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-uuid-or-username\",\n  \"username\": \"cryptowolf\",\n  \"reason\": \"Severe abuse and repeat spamming\",\n  \"durationHours\": 24,\n  \"roomId\": null\n}"
            },
            "url": {
              "raw": "{{adminBaseUrl}}/social/chat/bans",
              "host": [
                "{{adminBaseUrl}}"
              ],
              "path": [
                "social",
