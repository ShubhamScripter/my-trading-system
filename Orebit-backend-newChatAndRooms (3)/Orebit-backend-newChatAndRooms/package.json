{
  "name": "orebit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for Orebit - NestJS, Fastify, Prisma, Redis, Vitest",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "node --watch --env-file=.env -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier --write \"src/**/*.ts\" \"auth/**/*.ts\" \"db/**/*.ts\" \"redis/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/redis/quota.integration.spec.ts",
    "prisma:generate": "prisma generate --schema=db/schema.prisma",
    "prisma:studio": "prisma studio --schema=db/schema.prisma",
    "db:migrate": "tsx --env-file=.env db/migrate.ts",
    "db:verify": "tsx --env-file=.env db/migrate.ts --verify",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "test:chat": "vitest run --config vitest.chat.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/websockets": "^11.0.1",
    "@prisma/client": "^6.4.0",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^8.57.1",
    "prettier": "^3.5.1",
    "prisma": "^6.4.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "orebit",
    "backend",
    "typescript",
    "nestjs",
    "fastify",
    "prisma",
    "redis"
  ],
  "author": "Orebit",
  "license": "ISC",
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
